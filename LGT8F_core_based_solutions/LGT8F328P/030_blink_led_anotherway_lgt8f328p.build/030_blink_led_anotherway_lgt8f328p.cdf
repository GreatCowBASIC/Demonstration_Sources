              ;set eepromVal.0 On
              264: SET EEPROMVAL.0 ON
              ;Else
              265: ELSE
              ;set eepromVal.0 Off
              266: SET EEPROMVAL.0 OFF
              ;end if
              267: END IF
              ;SET SPISRAM_SCK OFF
              269: SET SPISRAM_SCK OFF
              ;eepromValCounter++
              271: EEPROMVALCOUNTER++
