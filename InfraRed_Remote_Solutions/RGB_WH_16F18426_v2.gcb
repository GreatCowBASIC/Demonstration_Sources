Sub light_detect

'' ===== IZMAINA 08.08.2026: izlabota gaismas histereze un photo_off_sec filtrs =====
photosens = ReadAD(an1)'' FOTO SENSORS PRET GND.'' Gaisma -> photosens samazinas'' Tumsa  -> photosens palielinas
If photosens > lux_set+10 Then'' Tumsa: iesledz night_mode un atcel iesaktu izslegsanas filtru
    Set night_mode On
    photo_filt_bit = 0
    photo_off_sec = 0
End If

If photosens < lux_set-10 Then Set photo_filt_bit On'' Gaisma: tikai ja sensors ir vismaz 5 vienibas zem lux_set,sak skaitit izslegsanas aizturi

If photo_off_sec >= 20 Then photo_filt_bit = 0:  Set night_mode Off: photo_off_sec = 0'' photo_off_sec tiek skaitits Timer procedura tikai tad,ja photo_filt_bit = 1

'' ===== IZMAINAS BEIGAS 08.08.2026 =====
End Sub

sub IND_LED  ''  full_ind ir pie sub timer

if sett_execute_bit=1 then

   Select Case sett_case
    Case 0
        Set LED_ind Off
    Case 1
        If full_ind<6 Then Set LED_ind On Else Set LED_ind Off
    Case 2
        If full_ind<6 Or (full_ind>10 & full_ind<17) Then Set LED_ind On Else Set LED_ind Off
    Case 3
        If full_ind<6 Or (full_ind>10 & full_ind<17) Or (full_ind>21 & full_ind<28) Then Set LED_ind On Else Set LED_ind Off
    Case 4
        If full_ind<6 Or (full_ind>10 & full_ind<17) Or (full_ind>21 & full_ind<28) Or (full_ind>32 & full_ind<39) Then Set LED_ind On Else Set LED_ind Off
    Case 5
        Set LED_ind Off
    End Select
else

select case mode_case

case 0
if full<2 then set LED_ind on else set LED_ind off
case 1
if full<2 or ( Full>4 & full<7) then set LED_ind on else set LED_ind off
case 2
if full<2 or ( Full>4 & full<7) or ( Full>9 & full<12)  then set LED_ind on else set LED_ind off
''case 3
''if full<2 or ( Full>4 & full<7) or ( Full>9 & full<12) or ( Full>14 & full<17)  then set LED_ind on else set LED_ind off
end select

end if

end sub
