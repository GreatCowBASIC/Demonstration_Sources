#CHIP tiny13a, 1.2
//! Optiomising FOR-NEXT loops to use a legacy method.  See the HELP.
#DEFINE USELEGACYFORNEXT 
//! ReadAD leaves the DIDR (digital input disable) registers alone. This saves the code that
//! disables the digital input of the channel during the reading, so the program fits the 512 words of flash.
#DEFINE AD_NO_DIDR


#DEFINE RS232Out PORTB.1

'Config Software-UART
#DEFINE SendAHigh Set RS232Out ON
#DEFINE SendALow Set RS232Out OFF
#DEFINE SerPrintCR
#DEFINE SerPrintLF

DIR RS232Out OUT
DIR PortB.4 IN

InitSer 1, r9600, 1+WaitForStart, 8, 1, none, normal

DO

    Sersend 1, READAD(ADC2)
	WAIT 500 MS
    
LOOP

