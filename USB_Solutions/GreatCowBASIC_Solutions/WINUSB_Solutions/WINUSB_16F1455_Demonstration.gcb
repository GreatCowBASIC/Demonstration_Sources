'''A program  for GCGB and GCB.
'''--------------------------------------------------------------------------------------------------------------------------------
'''
'''Demonstration of the GCBASIC USB library with WinUSB: no driver to install.
'''
'''The device answers Windows' Microsoft OS descriptor requests (GCBASIC's usb.h with USB_WCID), so
'''Windows 8.1 and later load their own WinUSB driver when it is plugged in. The PC program
'''(PC_Application) sends the same vendor requests as the LibK/WinUSB version: only its USB ID changed.
'''
'''Connect the 16F1455 to the USB (the 14-pin board: the 16F1459 board's LEDs and switch)
'''  D+ to RA0 (pin 13), D- to RA1 (pin 12)
'''  a capacitor (1 uF) between VUSB3V3 (pin 11) and 0V
'''  no crystal: the internal oscillator and PLL (48 MHz)
'''  You can provide supply voltage via the USB, or, you can provide local voltage.
'''
''' The board's LEDs, switches and ADC channels, and their USB request codes, are in WINUSB_16F1455_Demonstration.h.
''' The PC program writes that header from its board file (BoardTypes.json): select the board and press Ctrl+G.
''' This program handles only the names the header defines:
'''   USBCONTROLOUTPUT1 to 8     outputs (LEDs): read, on and off
'''   USBCONTROLINPUT1 to 4      inputs (switches): request USBCONTROLINPUTSTATUS sends all four, 1 for one not defined
'''   USBCONTROLKEEPALIVE        the LED the keep-alive (request 255) toggles
'''   USBCONTROLADC1 to 4        ADC channels: 8 bits as one byte, 10 or 12 bits as two bytes, low byte first
''' A serial terminal at 115200bps can be connected to the USART TX pin for debug messages (when the USART is used).
'''
''' Use the Windows application to control!
'''
'''@author     EvanV
'''@licence    GPL
'''@version    3.0 (the board in WINUSB_16F1455_Demonstration.h; 2.0 WinUSB, no driver; 1.0 LibK/WinUSB with a driver)
'''@date       25/10/2026
'''********************************************************************************

' ----- Configuration
    #chip 16F1455, 48
    #option Explicit

    'The compiler's defaults: the internal 16 MHz oscillator with the 3x PLL (48 MHz); ACTCON below tunes it from USB


    ' ----- Constants for usb.h (GCBASIC's usb.h: USB_WCID from build 1660, 2026-10-19)
    'Define a name - 30 chars max long
    #define USB_PRODUCT_NAME  "GCBASIC WinUSB " + CHIPNAMESTR

    'The USB ID: 04D8:0052, bcdDevice 0x0100 (the PC program looks for the same). Windows remembers per VID / PID / bcdDevice whether a device has
    'the Microsoft OS descriptors, so this solution has a bcdDevice of its own.
    #define USB_VID 0x04D8
    #define USB_PID 0x0052
    #define USB_REV 0x0100

    'WinUSB without a driver: the Microsoft OS 1.0 descriptors, and this solution's own device interface GUID
    #define USB_WCID
    #define USB_WCID_GUID "{BFC2B144-FB5A-4F56-98AC-93BC164EED46}"

    #include <usb.h>

    ' ------ Version Control - optional

    #include "gcbversionnumber.cnt"
    'Include the GCBVersionNumber.cnt to increment versionString and create the build time string called GCBBuildTimeStr.
    ' versionString a string is created automatically.
    ' GCBBuildTimeStr is a string that is also created automatically.
    ' use "GCBVersionNumber.cnt" as this will create a local copy of the versionString tracker.
    ' if you use <GCBVersionNumber.cnt> this is a system wide versionString tracker.

    dim versionString as string * 40
    versionString = "Build"+GCBBuildStr
    versionString = versionString + "@"+GCBBuildTimeStr

    #IF SCRIPT_USART_USAGE_CHECK > 0
      HSerPrint "USB CGB  "
      HSerPrint versionString
      HSerPrintCRLF
    #ENDIF

    ' ------ End of Version Control


    'Define USB specific callback handlers

    'MANDATED to handle your solution
    #define USB_SETUP_HANDLER           SetupHandler_CallBack
    'optional callback handlers for error and descriptor call.
    #define USB_ERROR_HANDLER           ErrorHandler_CallBack
    #define USB_DESCRIPTOR_HANDLER      DescriptorHandler_CallBack

    ' ------ The board: pins and request codes (USBCONTROL...), written by the PC program (Ctrl+G)

        'The header sets the directions of the board's pins at startup (#startup USBControlInit, 90)
        #include "WINUSB_16F1455_Demonstration.h"

        'An ADC reading of more than 8 bits
        Dim USBControlADCValue As Word


        'No crystal: active clock tuning keeps the internal oscillator on the USB start-of-frame packets (ACTEN, ACTSRC = USB)
        ACTCON = 0x90

        // ----- Main body of program commences here
        Do
              'Do nothing just wait for the USB Interrupt
              'Do not sleep the MCU!!
        Loop

        end


        ' ----- Support methods.  User call backs
        Sub ErrorHandler_CallBack
          #IF SCRIPT_USART_USAGE_CHECK > 0
              HSerPrint "Error: "
              HSerPrint Hex(UEIR)
              HSerPrintCRLF
          #ENDIF
        End Sub

        ' The real handler - where the work is done. Each USBCONTROL... name is handled only when the header defines it.
        Sub SetupHandler_CallBack

              Select Case USBRequest

              'Output 1
              #ifdef USBCONTROLOUTPUT1
                    'Response to control request: Transfer USBCONTROLOUTPUT1_READ, send status of the output
                    Case USBCONTROLOUTPUT1_READ
                      USBBufferWrite( USBCONTROLOUTPUT1_LAT )

                    'Response to control request: Transfer USBCONTROLOUTPUT1_ON, turn on the output
                    Case USBCONTROLOUTPUT1_ON
                      Set USBCONTROLOUTPUT1 On

                    'Response to control request: Transfer USBCONTROLOUTPUT1_OFF, turn off the output
                    Case USBCONTROLOUTPUT1_OFF
                      Set USBCONTROLOUTPUT1 Off
              #endif

              'Output 2
              #ifdef USBCONTROLOUTPUT2
                    Case USBCONTROLOUTPUT2_READ
                      USBBufferWrite( USBCONTROLOUTPUT2_LAT )
                    Case USBCONTROLOUTPUT2_ON
                      Set USBCONTROLOUTPUT2 On
                    Case USBCONTROLOUTPUT2_OFF
                      Set USBCONTROLOUTPUT2 Off
              #endif

              'Output 3
              #ifdef USBCONTROLOUTPUT3
                    Case USBCONTROLOUTPUT3_READ
                      USBBufferWrite( USBCONTROLOUTPUT3_LAT )
                    Case USBCONTROLOUTPUT3_ON
                      Set USBCONTROLOUTPUT3 On
                    Case USBCONTROLOUTPUT3_OFF
                      Set USBCONTROLOUTPUT3 Off
              #endif

              'Output 4
              #ifdef USBCONTROLOUTPUT4
                    Case USBCONTROLOUTPUT4_READ
                      USBBufferWrite( USBCONTROLOUTPUT4_LAT )
                    Case USBCONTROLOUTPUT4_ON
                      Set USBCONTROLOUTPUT4 On
                    Case USBCONTROLOUTPUT4_OFF
                      Set USBCONTROLOUTPUT4 Off
              #endif

              'Output 5
              #ifdef USBCONTROLOUTPUT5
                    Case USBCONTROLOUTPUT5_READ
                      USBBufferWrite( USBCONTROLOUTPUT5_LAT )
                    Case USBCONTROLOUTPUT5_ON
                      Set USBCONTROLOUTPUT5 On
                    Case USBCONTROLOUTPUT5_OFF
                      Set USBCONTROLOUTPUT5 Off
              #endif

              'Output 6
              #ifdef USBCONTROLOUTPUT6
                    Case USBCONTROLOUTPUT6_READ
                      USBBufferWrite( USBCONTROLOUTPUT6_LAT )
                    Case USBCONTROLOUTPUT6_ON
                      Set USBCONTROLOUTPUT6 On
                    Case USBCONTROLOUTPUT6_OFF
                      Set USBCONTROLOUTPUT6 Off
              #endif

              'Output 7
              #ifdef USBCONTROLOUTPUT7
                    Case USBCONTROLOUTPUT7_READ
                      USBBufferWrite( USBCONTROLOUTPUT7_LAT )
                    Case USBCONTROLOUTPUT7_ON
                      Set USBCONTROLOUTPUT7 On
                    Case USBCONTROLOUTPUT7_OFF
                      Set USBCONTROLOUTPUT7 Off
              #endif

              'Output 8
              #ifdef USBCONTROLOUTPUT8
                    Case USBCONTROLOUTPUT8_READ
                      USBBufferWrite( USBCONTROLOUTPUT8_LAT )
                    Case USBCONTROLOUTPUT8_ON
                      Set USBCONTROLOUTPUT8 On
                    Case USBCONTROLOUTPUT8_OFF
                      Set USBCONTROLOUTPUT8 Off
              #endif

              'Inputs: always four bytes, inputs 1 to 4; 1 (a switch not pressed) for an input the header does not define
              #ifdef USBCONTROLINPUTSTATUS
                    Case USBCONTROLINPUTSTATUS
                      #ifdef USBCONTROLINPUT1
                          USBBufferWrite( USBCONTROLINPUT1 )
                      #endif
                      #ifndef USBCONTROLINPUT1
                          USBBufferWrite( 1 )
                      #endif
                      #ifdef USBCONTROLINPUT2
                          USBBufferWrite( USBCONTROLINPUT2 )
                      #endif
                      #ifndef USBCONTROLINPUT2
                          USBBufferWrite( 1 )
                      #endif
                      #ifdef USBCONTROLINPUT3
                          USBBufferWrite( USBCONTROLINPUT3 )
                      #endif
                      #ifndef USBCONTROLINPUT3
                          USBBufferWrite( 1 )
                      #endif
                      #ifdef USBCONTROLINPUT4
                          USBBufferWrite( USBCONTROLINPUT4 )
                      #endif
                      #ifndef USBCONTROLINPUT4
                          USBBufferWrite( 1 )
                      #endif
              #endif

              'ADC channels: the reading, low byte first when it is more than 8 bits
              #ifdef USBCONTROLADC1
                    Case USBCONTROLADC1_REQUEST
                      #if USBCONTROLADC1_BITS = 8
                          USBBufferWrite( ReadAD( USBCONTROLADC1 ) )
                      #endif
                      #if USBCONTROLADC1_BITS = 10
                          USBControlADCValue = ReadAD10( USBCONTROLADC1 )
                          USBBufferWrite( USBControlADCValue )
                          USBBufferWrite( USBControlADCValue_H )
                      #endif
                      #if USBCONTROLADC1_BITS = 12
                          USBControlADCValue = ReadAD12( USBCONTROLADC1 )
                          USBBufferWrite( USBControlADCValue )
                          USBBufferWrite( USBControlADCValue_H )
                      #endif
              #endif

              #ifdef USBCONTROLADC2
                    Case USBCONTROLADC2_REQUEST
                      #if USBCONTROLADC2_BITS = 8
                          USBBufferWrite( ReadAD( USBCONTROLADC2 ) )
                      #endif
                      #if USBCONTROLADC2_BITS = 10
                          USBControlADCValue = ReadAD10( USBCONTROLADC2 )
                          USBBufferWrite( USBControlADCValue )
                          USBBufferWrite( USBControlADCValue_H )
                      #endif
                      #if USBCONTROLADC2_BITS = 12
                          USBControlADCValue = ReadAD12( USBCONTROLADC2 )
                          USBBufferWrite( USBControlADCValue )
                          USBBufferWrite( USBControlADCValue_H )
                      #endif
              #endif

              #ifdef USBCONTROLADC3
                    Case USBCONTROLADC3_REQUEST
                      #if USBCONTROLADC3_BITS = 8
                          USBBufferWrite( ReadAD( USBCONTROLADC3 ) )
                      #endif
                      #if USBCONTROLADC3_BITS = 10
                          USBControlADCValue = ReadAD10( USBCONTROLADC3 )
                          USBBufferWrite( USBControlADCValue )
                          USBBufferWrite( USBControlADCValue_H )
                      #endif
                      #if USBCONTROLADC3_BITS = 12
                          USBControlADCValue = ReadAD12( USBCONTROLADC3 )
                          USBBufferWrite( USBControlADCValue )
                          USBBufferWrite( USBControlADCValue_H )
                      #endif
              #endif

              #ifdef USBCONTROLADC4
                    Case USBCONTROLADC4_REQUEST
                      #if USBCONTROLADC4_BITS = 8
                          USBBufferWrite( ReadAD( USBCONTROLADC4 ) )
                      #endif
                      #if USBCONTROLADC4_BITS = 10
                          USBControlADCValue = ReadAD10( USBCONTROLADC4 )
                          USBBufferWrite( USBControlADCValue )
                          USBBufferWrite( USBControlADCValue_H )
                      #endif
                      #if USBCONTROLADC4_BITS = 12
                          USBControlADCValue = ReadAD12( USBCONTROLADC4 )
                          USBBufferWrite( USBControlADCValue )
                          USBBufferWrite( USBControlADCValue_H )
                      #endif
              #endif

                'Response to control request: Transfer 255, keep alive
                Case USBDEVICEKEEPALIVE
                  USBBufferWrite( USBDEVICEKEEPALIVE )
                  #ifdef USBCONTROLKEEPALIVE
                      USBCONTROLKEEPALIVE = !USBCONTROLKEEPALIVE
                  #endif

                'Handle the others via the serial port as we do not know what they are
                Case Else
                  #IF SCRIPT_USART_USAGE_CHECK > 0
                      HSerPrint "Req "
                      HSerPrint USBTempBuffer(1)
                      HSerPrintCRLF
                  #ENDIF
              End Select

        End Sub

        Sub DescriptorHandler_Callback
            #IF SCRIPT_USART_USAGE_CHECK > 0
                HSerPrint "Desc: "
                HSerPrint USBDescType
                HSerPrintCRLF
            #ENDIF
        End Sub
