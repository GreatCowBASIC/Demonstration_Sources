'
' Writes a board's firmware header (Ctrl+G): the USBCONTROL... names, pins and USB request codes of a board type,
' for the GCBASIC WinUSB demonstration program, which includes it. The program handles only the names defined here,
' so a board with fewer LEDs or switches needs no change to the program.
'
' User: Evan R. Venn
' Date: 2026

Imports System.Globalization
Imports System.Text.RegularExpressions

Public Class FirmwareHeader

    'The request codes the firmware uses for itself: the keep-alive, and usb.h's Microsoft OS descriptor vendor code
    Private Const KeepAliveCode = 255
    Private Const WcidVendorCode = &H20

    Public Text As String
    'Things in the board file the firmware cannot do as described (the header is still written)
    Public Warnings As New List(Of String)

    Private ReadOnly Board As BoardType
    Private ReadOnly Header As New System.Text.StringBuilder
    Private ReadOnly Dirs As New List(Of String)

    Private Sub New(Board As BoardType)
        Me.Board = Board
    End Sub

    Public Shared Function Generate(Board As BoardType, SourceFile As String) As FirmwareHeader
        Dim Result As New FirmwareHeader(Board)
        Result.Build(SourceFile)
        Return Result
    End Function

    Private Sub Build(SourceFile As String)
        WriteTitle(SourceFile)
        WriteOutputs()
        WriteInputs()
        WriteKeepAlive()
        WriteAdcs()
        WriteInit()
        CheckCodes()
        Text = Header.ToString()
    End Sub

    Private Sub WriteTitle(SourceFile As String)
        Line("'''Board configuration: " & Board.Name)
        Line("'''--------------------------------------------------------------------------------------------------------------------------------")
        Line("'''")
        Line("'''The pins and USB request codes of the board, for the GCBASIC WinUSB demonstration program that includes this file")
        Line("'''(WINUSB_<chip>_Demonstration.gcb). The program handles only the USBCONTROL... names defined here:")
        Line("'''")
        Line("'''  USBCONTROLOUTPUTn       an output (LED): its pin, its _LAT bit, and its _READ, _ON and _OFF request codes")
        Line("'''                          (an output that is not a pin, e.g. drawn on a display, has only its request codes)")
        Line("'''  USBCONTROLINPUTn        an input (switch): its pin. USBCONTROLINPUTSTATUS reads inputs 1 to 4 (1 for one not defined)")
        Line("'''  USBCONTROLKEEPALIVE     the LED the keep-alive (request 255) toggles")
        Line("'''  USBCONTROLADCn          an ADC channel: its channel, its _REQUEST code, its _BITS (8, 10 or 12) and its _PIN")
        Line("'''")
        Line("'''USBControlInit sets the directions of the pins. It runs at startup (#startup USBControlInit, 90): the program does not call it.")
        Line("'''")
        Line("'''Generated by the WinUSB Demo Program (Ctrl+G) from the board file. Do not edit: change the board file and generate again.")
        Line("'''")
        Line("'''@board      " & Board.Id)
        Line("'''@source     " & SourceFile)
        Line("'''@date       " & DateTime.Now.ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture))
        Line("'''********************************************************************************")
    End Sub

    Private Sub WriteOutputs()
        Section("Outputs (LEDs)")
        If Board.Leds.Count = 0 Then Line("    'None")
        For Each Led In SortedBy(Board.Leds, Function(L) L.UsbControl)
            Line()
            Line("    '" & Describe(Led.Name, Led.IO))
            Dim Lat = LatOf(Led.Port)
            If Lat Is Nothing Then
                'Not a pin (an LED drawn on a display): only the codes, the program keeps the state itself
                Line("    '" & Led.UsbControl & " is not defined: '" & Led.Port & "' is not a pin; the program keeps its state")
            Else
                Define(Led.UsbControl, Led.Port)
                Define(Led.UsbControl & "_LAT", Lat)
                Dirs.Add("Dir " & Led.UsbControl & " Out")
            End If
            Define(Led.UsbControl & "_READ", Led.UsbCodeRead.ToString())
            Define(Led.UsbControl & "_ON", Led.UsbCodeOn.ToString())
            Define(Led.UsbControl & "_OFF", Led.UsbCodeOff.ToString())
        Next
    End Sub

    Private Sub WriteInputs()
        Section("Inputs (switches)")
        If Board.Switches.Count = 0 Then
            Line("    'None")
            Return
        End If

        'One request reads inputs 1 to 4, a byte each
        Dim StatusCode = Board.Switches(0).UsbCode
        Line()
        Define("USBCONTROLINPUTSTATUS", StatusCode.ToString())
        For Each Switch In SortedBy(Board.Switches, Function(S) S.UsbControl)
            Line()
            Line("    '" & Describe(Switch.Name, Switch.IO) & ": on at " & Switch.OnValue)
            If Switch.UsbCode <> StatusCode Then
                Warnings.Add(Switch.Name & ": usbCode " & Switch.UsbCode & ", but the firmware reads all inputs with " & StatusCode)
            End If
            Dim Number = NumberOf(Switch.UsbControl)
            If Number > 0 AndAlso Switch.ReplyByte <> Number - 1 Then
                Warnings.Add(Switch.Name & ": replyByte " & Switch.ReplyByte & ", but the firmware sends " & Switch.UsbControl & " as byte " & (Number - 1))
            End If
            If LatOf(Switch.Port) Is Nothing Then
                NotAPin(Switch.UsbControl, Switch.Port)
                Continue For
            End If
            Define(Switch.UsbControl, Switch.Port)
            Dirs.Add("Dir " & Switch.UsbControl & " In")
        Next
    End Sub

    Private Sub WriteKeepAlive()
        Section("Keep-alive LED")
        If Board.KeepAlive Is Nothing Then
            Line("    'None")
            Return
        End If
        Line()
        Line("    '" & Describe(Board.KeepAlive.Name, Board.KeepAlive.IO) & ": toggled by the keep-alive (request " & KeepAliveCode & ")")
        If LatOf(Board.KeepAlive.Port) Is Nothing Then
            NotAPin(Board.KeepAlive.UsbControl, Board.KeepAlive.Port)
            Return
        End If
        Define(Board.KeepAlive.UsbControl, Board.KeepAlive.Port)
        Dirs.Add("Dir " & Board.KeepAlive.UsbControl & " Out")
    End Sub

    Private Sub WriteAdcs()
        Section("ADC channels")
        If Board.Adcs.Count = 0 Then
            Line("    'None")
            Return
        End If
        Dim Codes As New HashSet(Of Byte)
        For Each Adc In SortedBy(Board.Adcs, Function(A) A.UsbControl)
            Line()
            Line("    '" & Describe(Adc.Name, Adc.IO) & ": " & Adc.Port & ", 0-" & Adc.RangeMax)
            If Not Regex.IsMatch(Adc.Channel, "^ANA?\d+$", RegexOptions.IgnoreCase) Then
                Line("    '" & Adc.UsbControl & " is not defined: channel '" & Adc.Channel & "' is not ANx or ANAx")
                Warnings.Add(Adc.Name & ": channel '" & Adc.Channel & "' is not ANx or ANAx, so " & Adc.UsbControl & " is not defined")
                Continue For
            End If
            If Adc.ReplyByte <> 0 Then
                Warnings.Add(Adc.Name & ": replyByte " & Adc.ReplyByte & ", but the firmware sends each ADC channel as the whole reply (byte 0)")
            End If
            If Not Codes.Add(Adc.UsbCode) Then
                Warnings.Add(Adc.Name & ": usbCode " & Adc.UsbCode & " is used by another ADC channel; the firmware needs one code each")
            End If
            Define(Adc.UsbControl, Adc.Channel.ToUpperInvariant())
            Define(Adc.UsbControl & "_REQUEST", Adc.UsbCode.ToString())
            Define(Adc.UsbControl & "_BITS", BitsOf(Adc.RangeMax).ToString())
            'Its pin is an input (ReadAD makes the channel analog when it reads)
            If LatOf(Adc.Port) IsNot Nothing Then
                Define(Adc.UsbControl & "_PIN", Adc.Port)
                Dirs.Add("Dir " & Adc.UsbControl & "_PIN In")
            End If
        Next
    End Sub

    Private Sub WriteInit()
        Section("Pin directions: set at startup")
        Line()
        Line("    #startup USBControlInit, 90")
        Line()
        Line("    Sub USBControlInit")
        If Dirs.Count = 0 Then Line("        'No pins")
        For Each DirLine In Dirs
            Line("        " & DirLine)
        Next
        Line("    End Sub")
    End Sub

    'Each request code once: the firmware's Select Case takes the first match
    Private Sub CheckCodes()
        Dim Owners As New Dictionary(Of Integer, String)
        Dim Claim = Sub(Code As Integer, Owner As String)
                        If Code = KeepAliveCode OrElse Code = WcidVendorCode Then
                            Warnings.Add(Owner & ": request " & Code & " is the firmware's own (" & If(Code = KeepAliveCode, "keep-alive", "USB_WCID vendor code") & ")")
                        ElseIf Owners.ContainsKey(Code) Then
                            Warnings.Add(Owner & ": request " & Code & " is also " & Owners(Code))
                        Else
                            Owners(Code) = Owner
                        End If
                    End Sub
        For Each Led In Board.Leds
            Claim(Led.UsbCodeRead, Led.UsbControl & "_READ")
            Claim(Led.UsbCodeOn, Led.UsbControl & "_ON")
            Claim(Led.UsbCodeOff, Led.UsbControl & "_OFF")
        Next
        If Board.Switches.Count > 0 Then Claim(Board.Switches(0).UsbCode, "USBCONTROLINPUTSTATUS")
        For Each Adc In Board.Adcs
            Claim(Adc.UsbCode, Adc.UsbControl & "_REQUEST")
        Next
    End Sub

    'PORTD.0 -> LATD.0; Nothing when the port is not a pin ("OLED")
    Private Shared Function LatOf(Port As String) As String
        Dim Pin = Regex.Match(If(Port, "").Trim(), "^PORT([A-K])\.([0-7])$", RegexOptions.IgnoreCase)
        If Not Pin.Success Then Return Nothing
        Return "LAT" & Pin.Groups(1).Value.ToUpperInvariant() & "." & Pin.Groups(2).Value
    End Function

    Private Shared Function BitsOf(RangeMax As Integer) As Integer
        If RangeMax <= 255 Then Return 8
        If RangeMax <= 1023 Then Return 10
        Return 12
    End Function

    'USBCONTROLINPUT3 -> 3
    Private Shared Function NumberOf(UsbControl As String) As Integer
        Dim Digits = Regex.Match(If(UsbControl, ""), "\d+$")
        Return If(Digits.Success, Integer.Parse(Digits.Value, CultureInfo.InvariantCulture), 0)
    End Function

    Private Shared Function SortedBy(Of T)(Items As List(Of T), Key As Func(Of T, String)) As List(Of T)
        Dim Sorted As New List(Of T)(Items)
        Sorted.Sort(Function(A, B) String.CompareOrdinal(Key(A), Key(B)))
        Return Sorted
    End Function

    Private Shared Function Describe(Name As String, IO As String) As String
        If String.IsNullOrEmpty(IO) Then Return Name
        Return Name & ", " & IO
    End Function

    Private Sub NotAPin(UsbControl As String, Port As String)
        Line("    '" & UsbControl & " is not defined: '" & Port & "' is not a pin")
    End Sub

    Private Sub Section(Title As String)
        Line()
        Line("' ----- " & Title)
    End Sub

    Private Sub Define(Name As String, Value As String)
        Line("    #define " & Name.PadRight(28) & Value)
    End Sub

    Private Sub Line(Optional Text As String = "")
        Header.Append(Text).Append(vbCrLf)
    End Sub

End Class
