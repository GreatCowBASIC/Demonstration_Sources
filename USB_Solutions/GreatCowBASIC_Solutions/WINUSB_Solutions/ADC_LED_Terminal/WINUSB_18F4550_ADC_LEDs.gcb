'''A program  for GCGB and GCB.
'''--------------------------------------------------------------------------------------------------------------------------------
'''
'''USB comms demonstration: the PC reads the PICDEM FS USB board's potentiometer and sets its four LEDs.
'''
'''The loop, driven by the PC (the ADC LED Terminal, ADC_LED_Terminal.exe), over USB (WinUSB, no driver to install):
'''  1. The PC sends request 150: the board reads the potentiometer (AN0, 10 bits) and replies with the reading
'''  2. The PC works out the LEDs from the reading (the top four bits, 0 to 15)
'''  3. The PC sends request 151 with the LEDs: the board sets D1 to D4
'''  4. Back to 1
'''The board makes no decisions: with no PC, the LEDs stay as the PC last set them.
'''
'''The PICDEM FS USB Demo Board, 2004, with a PIC18F4550
'''  USB: the board's USB connector (D+ RC5, D- RC4), 20 MHz crystal, PLL (48 MHz)
'''  Potentiometer RV1 on RA0 (AN0)
'''  LEDs D1, D2, D3, D4 on RD0, RD1, RD2, RD3
'''
''' Request 150: read: two bytes, the reading (a Word: low byte, then high byte, 0 to 1023)
''' Request 151: write: the LEDs in wValue's low byte (0 to 15, D1 the lowest bit), no data
''' Request 255: the keep-alive: answers 255
'''
''' Its own USB identity: 04D8:0052 with bcdDevice 0x0200 and its own GUID, so the WinUSB Demo Program (bcdDevice
''' 0x0100) does not open it, and the terminal does not open the demonstration programs.
'''
'''@author     EvanV
'''@licence    GPL
'''@version    1.1
'''@date       25/10/2026
'''********************************************************************************

' ----- Configuration
    #chip 18F4550, 48
    #option Explicit

    '20 MHz crystal: PLLDIV = 5 (4 MHz into the PLL), 96 MHz PLL, CPUDIV = OSC1_PLL2 and USBDIV = 2 (48 MHz both),
    'the USB regulator on (VUSB)
    #config FOSC = HSPLL_HS, PLLDIV = 5, CPUDIV = OSC1_PLL2, USBDIV = 2, VREGEN = ON
    #config MCLRE = ON, PBADEN = OFF, LVP = OFF, WDT = OFF


    ' ----- Constants for usb.h (GCBASIC's usb.h with USB_WCID)
    #define USB_PRODUCT_NAME  "GCBASIC WinUSB ADC LEDs"

    'The USB ID: 04D8:0052, bcdDevice 0x0200 (the terminal looks for the same)
    #define USB_VID 0x04D8
    #define USB_PID 0x0052
    #define USB_REV 0x0200

    'WinUSB without a driver: the Microsoft OS 1.0 descriptors, and this solution's own device interface GUID
    #define USB_WCID
    #define USB_WCID_GUID "{C1060DC6-E7CA-4011-AA82-B63E9A555A20}"

    'The handler of the PC's requests
    #define USB_SETUP_HANDLER           SetupHandler_CallBack

    #include <usb.h>


    ' ----- The requests
    #define ADCREAD                     150         'read: the reading, 2 bytes, low first
    #define LEDSWRITE                   151         'write: the LEDs in wValue's low byte

    'The setup packet's wValue low byte (usb.h keeps the setup packet in USBTempBuffer: 2 is wValue's low byte)
    #define USBREQUESTVALUE             USBTempBuffer(2)


    ' ----- The board
    #define POTENTIOMETER               AN0         'RV1 on RA0
    #define POTENTIOMETER_PIN           PORTA.0

    'D1 to D4 are RD0 to RD3: the low four bits of PORTD
    Dir PORTD.0 Out
    Dir PORTD.1 Out
    Dir PORTD.2 Out
    Dir PORTD.3 Out
    Dir POTENTIOMETER_PIN In

    'All off until the PC sets them
    LATD = LATD And 0xF0

    Dim ADCValue As Word                        'the reading, for request 150


    ' ----- Main body of program commences here: nothing to do, the USB interrupt answers the PC
    Do
        'Do not sleep the MCU!!
    Loop

    end


    ' ----- The USB requests: in the USB interrupt
    Sub SetupHandler_CallBack

        Select Case USBRequest

            'Read the potentiometer and send the reading: a Word, its low byte, then its high byte
            Case ADCREAD
                ADCValue = ReadAD10( POTENTIOMETER )
                USBBufferWrite( ADCValue )

            'Set D1 to D4 (RD0 to RD3) to the PC's LEDs; RD4 to RD7 unchanged
            Case LEDSWRITE
                LATD = ( LATD And 0xF0 ) Or ( USBREQUESTVALUE And 0x0F )

            'The keep-alive
            Case USBDEVICEKEEPALIVE
                USBBufferWrite( USBDEVICEKEEPALIVE )

            Case Else
        End Select

    End Sub
