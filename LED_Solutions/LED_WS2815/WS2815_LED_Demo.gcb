' A demonstration of GCBASIC driving WS2815 LEDs on an ATmega32U4
'
'   • One WS2815 drive method:
'         • Bit-banged timing (WS2815BitBangSendData)
'           Two color of the LED's can be defined in the program
'           NOP counts tuned for 16 MHz AVR. Do NOT port directly to PIC
'           or any other clock speed without re-measuring on a scope.
'
'   • WS2815 DIN          → PortB.7 (Pin 12) 
'
'************************************************************************
' MCU:      ATmega32U4
' Clock:    16 MHz
' Compiler: GCBASIC
' IDE:      GCCode
' Author:   EvanV
' Licence:  GPL
' Version:  1.01
' Date:     08-06-2026
'************************************************************************

'----- Configuration -----
#chip mega32u4, 16
#option explicit

#define WS2815SendData WS2815BitBangSendData

'----- Hardware Definitions -----

#define DIN PORTB.7
dir DIN out

'----- Variables -----

dim PixelCount          as byte
dim YLoop               as byte
dim XLoop               as byte
dim TimeoutOccurred     as byte
dim CurrentAddressedLED as byte

dim ColorToSend         as long



'----- Main Program -----

MainCode:

    PixelCount          = 16
    CurrentAddressedLed = 1
    
    WS2815_Init

'========================================================================
' WS2815 Color Constants (GRB order)
' 64 unique colors with descriptive names + Greys
'========================================================================

#define WS2815_Color_BLACK          0x000000
#define WS2815_Color_WHITE          0xFFFFFF

#define WS2815_Color_RED            0x00FF00
#define WS2815_Color_GREEN          0xFF0000
#define WS2815_Color_BLUE           0x0000FF

#define WS2815_Color_YELLOW         0xFFFF00
#define WS2815_Color_CYAN           0xFF00FF
#define WS2815_Color_MAGENTA        0x00FFFF

#define WS2815_Color_ORANGE         0x00A500
#define WS2815_Color_PINK           0x00FF80
#define WS2815_Color_PURPLE         0x4000FF
#define WS2815_Color_LIME           0xBFFF00
#define WS2815_Color_TEAL           0xFF0080

' === Greys ===
#define WS2815_Color_GREY_10        0x1A1A1A
#define WS2815_Color_GREY_20        0x333333
#define WS2815_Color_GREY_30        0x4D4D4D
#define WS2815_Color_GREY_40        0x666666
#define WS2815_Color_GREY_50        0x808080
#define WS2815_Color_GREY_60        0x999999
#define WS2815_Color_GREY_70        0xB3B3B3
#define WS2815_Color_GREY_80        0xCCCCCC
#define WS2815_Color_GREY_90        0xE6E6E6

' === Rich Color Palette ===
#define WS2815_Color_DARK_RED       0x008000
#define WS2815_Color_CRIMSON        0x00C800
#define WS2815_Color_TOMATO         0x00FF40
#define WS2815_Color_CORAL          0x00FF70
#define WS2815_Color_SALMON         0x00FF90

#define WS2815_Color_GOLD           0xFFD000
#define WS2815_Color_AMBER          0xFFAA00
#define WS2815_Color_DARK_ORANGE    0xFF7000
#define WS2815_Color_ORANGE_RED     0xFF3000

#define WS2815_Color_HOT_PINK       0x00FFAA
#define WS2815_Color_DEEP_PINK      0x00FFCC
#define WS2815_Color_LIGHT_PINK     0x00FFEE

#define WS2815_Color_VIOLET         0x6000FF
#define WS2815_Color_INDIGO         0x3000FF
#define WS2815_Color_LAVENDER       0x9000FF

#define WS2815_Color_DARK_BLUE      0x000080
#define WS2815_Color_ROYAL_BLUE     0x0020FF
#define WS2815_Color_SKY_BLUE       0x00A0FF
#define WS2815_Color_LIGHT_BLUE     0x00D0FF
#define WS2815_Color_AZURE          0x00F0FF

#define WS2815_Color_DARK_CYAN      0xFF0080
#define WS2815_Color_AQUA           0xFF40C0
#define WS2815_Color_TURQUOISE      0xFF70E0

#define WS2815_Color_DARK_GREEN     0x800000
#define WS2815_Color_FOREST_GREEN   0xA00000
#define WS2815_Color_SEA_GREEN      0xC80000
#define WS2815_Color_SPRING_GREEN   0xE8FF00
#define WS2815_Color_CHARTREUSE     0xD0FF00

#define WS2815_Color_OLIVE          0x408000
#define WS2815_Color_KHAKI          0x80C000
#define WS2815_Color_YELLOW_GREEN   0xAAFF00

#define WS2815_Color_BROWN          0x204000
#define WS2815_Color_MAROON         0x104000
#define WS2815_Color_SIENNA         0x306000

#define WS2815_Color_DEEP_PURPLE    0x2000C0
#define WS2815_Color_FUCHSIA        0x00FFCC
#define WS2815_Color_MAUVE          0x7000FF

#define WS2815_Color_MINT           0xFF80A0
#define WS2815_Color_PALE_GREEN     0xC0FF80
#define WS2815_Color_LIME_GREEN     0x80FF00

#define WS2815_Color_NAVY           0x000040
#define WS2815_Color_MIDNIGHT_BLUE  0x0000A0
#define WS2815_Color_DODGER_BLUE    0x0080FF

#define WS2815_Color_VERY_DIM_WHITE 0x050505    ' Very dim white/grey - lowest noticeable white
#define WS2815_Color_DIM_GREY       0x0A0A0A    ' Low power grey
#define WS2815_Color_DARK_GREY      0x1A1A1A    ' Slightly brighter but still low power

' Single color very low power (even lower consumption)
#define WS2815_Color_VERY_DIM_RED   0x000A00
#define WS2815_Color_VERY_DIM_GREEN 0x0A0000
#define WS2815_Color_VERY_DIM_BLUE  0x00000A


    do

        for YLoop = 1 to PixelCount

            //! Turn off the interrupt to ensure the timing is good.
            intoff
            
            for XLoop = 1 to PixelCount

                if XLoop = CurrentAddressedLED then
                    ColorToSend = WS2815_Color_BLUE
                else
                    ColorToSend = WS2815_Color_VERY_DIM_RED 
                end if

                WS2815SendData(ColorToSend)

            next
            inton

            ' Wait for the 300 µs timer tick before sending a new frame
            TimeoutOccurred = 0
            wait while TimeoutOccurred = 0

            'Now so your eye can see it...
            wait 50 ms
            
            CurrentAddressedLED++

        next

        CurrentAddressedLED = 1
        
    loop

end


'----- Subroutines -----

sub WS2815_Init

    TimeoutOccurred = 0

    ' Timer 0 CTC mode — fires every 300 µs 
    '
    ' OCR0A = 74 → 75 ticks @ prescaler 64 = 300 µs at 16 MHz
    ' (Timer 0 is 8-bit, perfect for this value)

    #define period_ticks 74

    ' 1. Stop and clear Timer 0
    TCCR0A = 0
    TCCR0B = 0
    TCNT0  = 0

    ' 2. Load compare match value
    OCR0A = period_ticks

    ' 3. CTC mode: WGM01 = 1 (Clear Timer on Compare Match)
    WGM01 = 1

    ' 4. Start timer: prescaler 64 (CS01=1, CS00=1)
    TCCR0B.CS01 = 1
    TCCR0B.CS00 = 1

    ' 5. Enable Timer 0 Output Compare A Match interrupt
    TIMSK0 = TIMSK0 OR (1 << OCIE0A)

    On Interrupt Timer0Match1 call ISR0

    ' Brief DIN pulse followed by >500 µs low — power-on reset
    set DIN on
    nop:nop
    set DIN off
    wait 500 us

end sub


Sub WS2815BitBangSendData(in ColortoSend as long)

    ' Sends 24 bits (GRB) to one WS2815 pixel using bit-banged timing.
    '
    ' Timing targets (WS2815 datasheet, variable tolerances):
    '   1 bit: T_H ≈ 580-1600 ns high,  T_L ≈ 220-420  ns low
    '   0 bit: T_H ≈ 220-380  ns high,  T_L ≈ 580-1600 ns low
    '
    ' At 16 MHz one cycle = 62.5 ns.
    '
    ' 1-bit path:  sbi(1) + nop×14(14) + SET DIN OFF(1) = 16 cycles = 1000 ns high ✓
    ' 0-bit path:  sbi(1) + nop×2(2)   + SET DIN OFF(1) = 4  cycles = 250  ns high ✓
    '
    ' After SET DIN OFF the ROTATE executes while DIN is already low.
    ' The ROTATE on a Long uses lds/rol/sts × 4 bytes ≈ 12 cycles = 750 ns.
    ' This provides the inter-bit low time — within spec (min 450 ns).
    '
    ' *** AVR-SPECIFIC — DO NOT PORT WITHOUT RE-TUNING ***
    ' NOP counts are calibrated for 16 MHz AVR. A PIC or different clock
    ' will require completely different counts; verify every change on a scope.
    '
    ' Rule: SET DIN OFF must remain inside each branch of the IF/END IF.
    '       Moving it outside extends the high time on both paths and breaks timing.
    '       ROTATE stays after END IF to use its cycles as low-time inter-bit padding.

    repeat 24
        
        IF ColortoSend.23 ON THEN
            ' 1 bit — ~1000 ns high
            SET DIN ON
            nop:nop:nop:nop:nop:nop:nop
            nop:nop:nop:nop:nop:nop:nop
            SET DIN OFF
        else
            ' 0 bit — ~250 ns high
            SET DIN ON
            nop:nop
            SET DIN OFF
        END IF
        
        ROTATE ColortoSend left     ' Executed while DIN is low — free inter-bit delay
    
    end repeat

End Sub


sub ISR0
    ' Timer 0 every 300 µs.
    ' Sets the flag that the main loop waits on before sending the next frame.
    TimeoutOccurred = 1
end sub
