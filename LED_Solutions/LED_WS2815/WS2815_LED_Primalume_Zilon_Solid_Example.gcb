' A demonstration of GCBASIC driving WS2815 LEDs on an ATmega32U4
'
' This demonstration contains:
'   • Two demo modes:
'         1. Chaser    – LEDs light in sequence
'         2. Flash All – all LEDs set to the same colour
'
'   • One WS2815 drive method:
'         • Bit-banged timing (WS2815BitBangSendData)
'           NOP counts tuned for 16 MHz AVR. Do NOT port directly to PIC
'           or any other clock speed without re-measuring on a scope.
'
' Operation:
'   • On power-up, Chaser mode is active.
'   • Pressing the switch toggles between Chaser and Flash-All modes.
'
' Hardware Connections (ATmega32U4):
'   • WS2815 DIN          → PB7
'   • Switch (active-low) → PD4
'
'************************************************************************
' MCU:      ATmega32U4
' Clock:    16 MHz
' Compiler: GCBASIC
' IDE:      GCCode
' Author:   EvanV
' Licence:  GPL
' Version:  1.01
' Date:     08-06-2026
'************************************************************************


'----- Configuration -----
#chip mega32u4, 16
#option explicit

// #define WS2815SendData WS2815BitBangSendData 
//! or
#define WS2815SendData WS2812SendUltraFast


'----- Hardware Definitions -----

#define DIN PORTB.7
dir DIN out

#define SWITCH PORTD.4
dir SWITCH in

#define SWITCH_UP   1
#define SWITCH_DOWN 0

'----- Variables -----

dim PixelCount              as byte
dim YLoop                   as byte
dim XLoop                   as byte
dim TimeoutOccurred         as byte
dim DemoMode            as byte
dim SwitchState             as byte
dim CurrentAddressedLED     as byte
dim CurrentLEDColorSequence as byte
dim LEDZilon as Byte = 1

dim ColorOfLED              as long
dim ColorToSend             as long

'----- Main Program -----

MainCode:

    PixelCount              = 8
    CurrentAddressedLED     = 0  // Zero offset
    CurrentLEDColorSequence = 0
    //! Change this 0 or 1
    DemoMode            = 1

    SwitchState             = SWITCH_Down

    WS2815_Init

    ' Colour table — 5 entries stored as packed Long values 
    

    dim ColorArray(24)

    SetLongArrayValueHandler(ColorArray, 0, 0x00FF00)   ' Red
    SetLongArrayValueHandler(ColorArray, 1, 0x0000FF)   ' Blue
    SetLongArrayValueHandler(ColorArray, 2, 0xFF0000)   ' Green
    SetLongArrayValueHandler(ColorArray, 3, 0xFFFFFF)   ' White
    SetLongArrayValueHandler(ColorArray, 4, 0x000000)   ' Black (off)

    do

        ColorOfLED = GetLongArrayValueHandler(ColorArray, CurrentLEDColorSequence)

        'Wait for the 300 µs timer tick before sending a new frame
        wait while TimeoutOccurred = 0
        intoff

        for XLoop = 1 to PixelCount

            ' === Determine color for this pixel ===
            if DemoMode = 0 then
                ' Flash-All Mode: Every LED shows the same color
                ColorToSend = ColorOfLED
                
            else
                ' Chaser Mode: Only the active LED is lit
                if XLoop = CurrentAddressedLED then
                    ColorToSend = ColorOfLED
                else
                    ColorToSend = 0x000000
                end if
            end if

            WS2815SendData(ColorToSend)
            
        next

        /*if SWITCH = SWITCH_DOWN and SwitchState = SWITCH_UP then
            DemoMode = !DemoMode
            SwitchState  = SWITCH_DOWN
        end if

        if SWITCH = SWITCH_UP then
            SwitchState = SWITCH_UP
        end if*/

        TimeoutOccurred = 0
        inton

        
        ' ===================================================================
        ' Advance Animation State - Mode-Specific Logic
        ' ===================================================================
        ' This section updates the animation after each frame is sent.
        ' The behavior is completely different depending on the current demo mode.

        If DemoMode = 0 then 
            ' ==================== FLASH-ALL MODE ====================
            ' All 8 LEDs show the same color.
            ' We change color every 1 second.

            wait 1 s                                ' Hold current color for 1 second
            
            CurrentLEDColorSequence++               ' Move to next color in list/array
            
            If CurrentLEDColorSequence = 5 then 
                CurrentLEDColorSequence = 0         ' Wrap around (use 4 colors total)
            End If

        Else
            ' ==================== CHASER MODE ====================
            ' Only one LED is lit at a time.
            ' The lit LED moves back and forth along the strip.
            ' Color changes only after completing a full back-and-forth pass.

            ' Read next position from the movement table
            ReadTable LEDSequence, LEDZilon, CurrentAddressedLED
            
            LEDZilon++                              ' Move to next step in the path

            ' Check if we have reached the end of the movement table
            If LEDZilon = 17 then                   ' We have this many data points plus one as we have indexed LEDZilon
                LEDZilon = 1                        ' Reset to start of table
                CurrentAddressedLED = 1             ' First LED
                
                CurrentLEDColorSequence++           ' Now Advance to next color
                
                ' Skip black (index 4) in Chaser mode for better visual effect
                If CurrentLEDColorSequence = 4 then 
                    CurrentLEDColorSequence = 0     
                End If
                ' No delay as the additional processes hold the eye for long enough
                // wait 5 ms                              ' Controls animation speed (step delay)
            Else
                wait 100 ms                              ' Controls animation speed (step delay)
            End If


        End If

    loop

end

Table LEDSequence
    1, 2, 3, 4, 5, 6, 7, 8, 8, 7, 6, 5, 4, 3, 2, 1
End Table
'----- Subroutines -----

sub WS2815_Init

    TimeoutOccurred = 0

    ' Timer 0 CTC mode — fires every 300 µs 
    '
    ' OCR0A = 74 → 75 ticks @ prescaler 64 = 300 µs at 16 MHz
    ' (Timer 0 is 8-bit, perfect for this value)

    #define period_ticks 74

    ' 1. Stop and clear Timer 0
    TCCR0A = 0
    TCCR0B = 0
    TCNT0  = 0

    ' 2. Load compare match value
    OCR0A = period_ticks

    ' 3. CTC mode: WGM01 = 1 (Clear Timer on Compare Match)
    WGM01 = 1

    ' 4. Start timer: prescaler 64 (CS01=1, CS00=1)
    TCCR0B.CS01 = 1
    TCCR0B.CS00 = 1

    ' 5. Enable Timer 0 Output Compare A Match interrupt
    TIMSK0 = TIMSK0 OR (1 << OCIE0A)

    On Interrupt Timer0Match1 call ISR0

    ' Brief DIN pulse followed by >500 µs low — power-on reset
    set DIN on
    nop:nop
    set DIN off
    wait 500 us

end sub


Sub WS2815BitBangSendData(in ColortoSend as long)

    ' Sends 24 bits (GRB) to one WS2815 pixel using bit-banged timing.
    '
    ' Timing targets (WS2815 datasheet, variable tolerance):
    '   1 bit: T_H ≈ 580-1600 ns high,  T_L ≈ 220-420  ns low
    '   0 bit: T_H ≈ 220-380  ns high,  T_L ≈ 580-1600 ns low
    '
    ' At 16 MHz one cycle = 62.5 ns.
    '
    ' 1-bit path:  sbi(1) + nop×14(14) + SET DIN OFF(1) = 16 cycles = 1000 ns high
    ' 0-bit path:  sbi(1) + nop×2(2)   + SET DIN OFF(1) = 4  cycles = 250  ns high
    '
    ' After SET DIN OFF the ROTATE executes while DIN is already low.
    ' The ROTATE on a Long uses lds/rol/sts × 4 bytes ≈ 12 cycles = 750 ns.
    ' This provides the inter-bit low time — within spec (min 450 ns).
    '
    ' *** AVR-SPECIFIC — DO NOT PORT WITHOUT RE-TUNING ***
    ' NOP counts are calibrated for 16 MHz AVR. A PIC or different clock
    ' will require completely different counts; verify every change on a scope.
    '
    ' Rule: SET DIN OFF must remain inside each branch of the IF/END IF.
    '       Moving it outside extends the high time on both paths and breaks timing.
    '       ROTATE stays after END IF to use its cycles as low-time inter-bit padding.

    repeat 24
        
        IF ColortoSend.23 ON THEN
            ' 1 bit — ~1000 ns high
            SET DIN ON
            nop:nop:nop:nop:nop:nop:nop
            nop:nop:nop:nop:nop:nop:nop
            SET DIN OFF
        else
            ' 0 bit — ~250 ns high
            SET DIN ON
            nop:nop
            SET DIN OFF
        END IF
        
        ROTATE ColortoSend left     ' Executed while DIN is low — free inter-bit delay
    
    end repeat

End Sub


function GetLongArrayValueHandler(in AddressArray(), ElementPointer) as long

    ElementPointer = (ElementPointer * 4) + ElementPointer

    GetLongArrayValueHandler     = AddressArray(ElementPointer)
    GetLongArrayValueHandler_H   = AddressArray(ElementPointer+1)
    GetLongArrayValueHandler_U   = AddressArray(ElementPointer+2)
    GetLongArrayValueHandler_E   = AddressArray(ElementPointer+3)

end function


sub SetLongArrayValueHandler(in AddressArray(), ElementPointer, in ElementValue as long)

    ElementPointer = (ElementPointer * 4) + ElementPointer

    AddressArray(ElementPointer)   = ElementValue
    AddressArray(ElementPointer+1) = ElementValue_H
    AddressArray(ElementPointer+2) = ElementValue_U
    AddressArray(ElementPointer+3) = ElementValue_E

end sub

sub ISR0
    ' Timer 0 every 300 µs.
    ' Sets the flag that the main loop waits on before sending the next frame.
    TimeoutOccurred = 1
end sub

//! Ultra fast!! Increases NOPs STATE as the code is faster.


#define WS2812_1_STATE set DIN on : nop:nop:nop:nop:nop:nop:nop:nop : set DIN off  
#define WS2812_0_STATE set DIN on : nop:nop:nop:nop:nop : set DIN off 


sub WS2812SendUltraFast(in ColorToSend as long)

    dim WS2812_CurrentByte as byte alias SYSBITTEST

    ' ----- BYTE 1: ColorToSend_U (R) -----
    WS2812_CurrentByte = ColorToSend_U

    if WS2812_CurrentByte.7 then WS2812_1_STATE else WS2812_0_STATE
    if WS2812_CurrentByte.6 then WS2812_1_STATE else WS2812_0_STATE
    if WS2812_CurrentByte.5 then WS2812_1_STATE else WS2812_0_STATE
    if WS2812_CurrentByte.4 then WS2812_1_STATE else WS2812_0_STATE
    if WS2812_CurrentByte.3 then WS2812_1_STATE else WS2812_0_STATE
    if WS2812_CurrentByte.2 then WS2812_1_STATE else WS2812_0_STATE
    if WS2812_CurrentByte.1 then WS2812_1_STATE else WS2812_0_STATE
    if WS2812_CurrentByte.0 then WS2812_1_STATE else WS2812_0_STATE


    ' ----- BYTE 2: ColorToSend_H (G) -----
    WS2812_CurrentByte = ColorToSend_H

    if WS2812_CurrentByte.7 then WS2812_1_STATE else WS2812_0_STATE
    if WS2812_CurrentByte.6 then WS2812_1_STATE else WS2812_0_STATE
    if WS2812_CurrentByte.5 then WS2812_1_STATE else WS2812_0_STATE
    if WS2812_CurrentByte.4 then WS2812_1_STATE else WS2812_0_STATE
    if WS2812_CurrentByte.3 then WS2812_1_STATE else WS2812_0_STATE
    if WS2812_CurrentByte.2 then WS2812_1_STATE else WS2812_0_STATE
    if WS2812_CurrentByte.1 then WS2812_1_STATE else WS2812_0_STATE
    if WS2812_CurrentByte.0 then WS2812_1_STATE else WS2812_0_STATE


    ' ----- BYTE 3: ColorToSend_E (B) -----
    WS2812_CurrentByte = ColorToSend

    if WS2812_CurrentByte.7 then WS2812_1_STATE else WS2812_0_STATE
    if WS2812_CurrentByte.6 then WS2812_1_STATE else WS2812_0_STATE
    if WS2812_CurrentByte.5 then WS2812_1_STATE else WS2812_0_STATE
    if WS2812_CurrentByte.4 then WS2812_1_STATE else WS2812_0_STATE
    if WS2812_CurrentByte.3 then WS2812_1_STATE else WS2812_0_STATE
    if WS2812_CurrentByte.2 then WS2812_1_STATE else WS2812_0_STATE
    if WS2812_CurrentByte.1 then WS2812_1_STATE else WS2812_0_STATE
    if WS2812_CurrentByte.0 then WS2812_1_STATE else WS2812_0_STATE

end sub
