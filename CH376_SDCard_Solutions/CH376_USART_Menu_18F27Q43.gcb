// A menu demo of the CH376 file methods: send a key from the serial terminal and the program does one job
// on the CH376's drive, and shows what happened.
//
// It does the jobs of CH376S_v3_17.gcb (Scott C, adapted to GCBASIC by Mike Otte, 2020), with the methods of
// ch376_sd.h: the same methods as the SD card libraries (sd_card.h, sd_fat.h), so no CH376 commands are sent
// here. The drive is started once and stays mounted; a job that fails says why, and the next job starts the
// drive again.
//
//   1  Check the CH376: reset it, start the drive, and show the chip version and the drive size (SDCInit)
//   2  Mount the drive and show its FAT type (FatMount)
//   3  Start again: reset the CH376, start the drive and mount it (FatInit)
//   4  Write TEST4.TXT: a new file with one line (FatDelete, FatOpen, FatAppendByte, FatCommit)
//   5  Read TEST4.TXT to the terminal (FatOpenRead, FatReadByte)
//   6  Add the 33-character line to TEST4.TXT (FatOpen, FatAppendByte, FatCommit)
//   7  Delete TEST4.TXT (FatDelete)
//   8  List the folder: names, sizes, folders (FatListFirst, FatListNext)
//   9  Add the first line to TEST4.TXT again
//   C  Change folder: type a folder name, .. (up one) or \ (the root), then Enter (FatChDir)
//   L  Log: every 2 s add "hh:mm:ss,value" to TEST4.TXT, with value = ReadAD(AN1). Any key stops it
//   ?  Show the menu
//
// The time in the log is the time since L was sent, counted by the waits, so it runs a little slow (the
// write time is not counted). There is no clock: the files are dated 2026-01-01 00:00 (FatDate / FatTime).
// The file name must be 8.3 (8 characters, a dot, 3 characters): the CH376 has no long names.
// The jobs work in the current folder (C changes it; the root at the start and after 1, 2 or 3).
//
// Board: PIC18F27Q43 (28-pin), 64 MHz internal oscillator, 3.3 V: the same set-up and pins as CH376_USART_DataLogger_18F27Q43.gcb
//        AN1    the analogue input, RA1 (0 .. 3.3 V gives 0 .. 255)
//        UART1  the CH376, 9600 8N1: TX RC6 to the CH376's RXD (P3 pin 2), RX RC7 from its TXD (P3 pin 1), GND (P3 pin 3)
//        CH376  INT# optional (CH376_INT): without it the status byte on TXD is used
//        UART2  the terminal, 115200 8N1: TX RC0 (and RC5), RX RC1
// CH376EVT board: UART selected - J1 off, J5 off, J6 off. No SCK or SDI wires on P2: the CH376's D4 / D5 / D6,
//        left open, give 9600 baud at power-up. +5 and GND on P2 or P3.
//        A USB stick (the default): supply 5V0 on +5, J2 off, J3 1-2 (North).
//        An SD card: J3 2-3, J2 on, and #define CH376_MEDIA_SDCARD below.
//        Wiring: README.md
//
//@author    Evan R. Venn
//@licence   LGPL 2.1
//@date      12/11/2026
//
// Change log
//   12/11/2026  First version: the jobs of CH376S_v3_17.gcb with the ch376_sd.h methods. ReadAD(AN1) is logged
//               in place of the DS18B20 temperature; key 8 lists the folder (it read the file a second time)
//   12/11/2026  A "> " prompt when the program is ready for a key, and the key is echoed after it
//   12/11/2026  C: change folder, to a name typed on the terminal, .. or \ (FatChDir); 8 shows the folder

    #option explicit
    #option IncludePath "C:\GCstudio\gcbasic\AdditionalLibraries;GCBASICLibraries"

// ----- Chip (the set-up of the ENC28J60 18F47Q43 rig)

    #Chip 18F27Q43, 64
    #Config FEXTOSC = OFF               // no external oscillator
    #Config RSTOSC = HFINTOSC_64MHZ     // internal oscillator, 64 MHz
    #Config MCLRE = EXTMCLR             // MCLR pin is reset (programmer)
    #Config WDTE = OFF
    #Config LVP = OFF
    #Config BOREN = OFF
    #Config STVREN = ON
    #Config XINST = OFF
    #Config PPS1WAY = OFF               // PPS may be set more than once

    // No I2C1 baud rate check message from the compiler (I2C is not used)
    #DEFINE MASKI2C1BAUDCHECKMESSAGE

// ----- Serial port: the terminal (UART2). The menu needs it

    #define USART2_BAUD_RATE 115200
    #define USART2_BLOCKING

// ----- Pins

    #define LOG_INPUT       PortA.1     // AN1, the input that is logged
    #define CH376_USART_TX  PortC.6     // UART1 TX, to the CH376's RXD (P3 pin 2)
    #define CH376_USART_RX  PortC.7     // UART1 RX, from the CH376's TXD (P3 pin 1)
    #define CONSOLE_TX      PortC.0     // UART2 TX, the terminal
    #define CONSOLE_TX2     PortC.5     // UART2 TX, a second terminal
    #define CONSOLE_RX      PortC.1     // UART2 RX, the terminal
    // #define CH376_INT    PortB.4     // the CH376's INT# (P3 pin 5): optional. Without it the status byte the
                                        // CH376 sends on TXD is used, so only TXD, RXD and GND are wired
    // Choose the media: define one (neither is the USB stick). Both is a compile error
    #define CH376_MEDIA_SDCARD               // the CH376's SD card socket (3V3)
    // #define CH376_MEDIA_USBSTICK                // the CH376's USB socket (5V0), the default

    // PPS: UART2 the terminal, UART1 the CH376. Only one #startup is allowed in a program
    #startup PPSInit, 85

    Sub PPSInit
        U1RXPPS = 0x17          // RC7 is UART1 RX, from the CH376's TXD
        RC6PPS = 0x20           // RC6 is UART1 TX, to the CH376's RXD
        Dir CH376_USART_TX Out
        Dir CH376_USART_RX In

        U2RXPPS = 0x11          // RC1 is UART2 RX, the terminal
        RC0PPS = 0x23           // RC0 is UART2 TX, the terminal
        RC5PPS = 0x23           // RC5 is UART2 TX (second terminal)
        Dir CONSOLE_TX Out
        Dir CONSOLE_TX2 Out
        Dir CONSOLE_RX In
    End Sub

// ----- The drive: a CH376 on UART1, with the SD card methods (in place of sd_card.h and sd_fat.h)

    // UART1 to the CH376: 9600 baud, the rate the CH376 starts at (its D4 / D5 / D6 pins choose it at
    // power-up: leave them open, eg no wires on P2, and they pull up to 9600)
    #define USART_BAUD_RATE 9600
    #define USART_BLOCKING

    #define CH376_COMMS_METHOD CH376_COMMS_USART  // the CH376 on a USART (also CH376_COMMS_SPI, CH376_COMMS_PARALLEL)
    #define CH376_UART_PORT    1                  // usart.h port 1: UART1
    #define CH376_UART_HASDATA USARTHasData       // UART1's "byte received"
    #include <ch376_sd.h>

// ----- Main program

    #define DEMO_FILE "TEST4.TXT"

    Dim Key As Byte                     // the key from the terminal
    Dim DriveReady As Bit               // 1 = the drive is started and mounted
    Dim LineOne As String * 32
    Dim LineTwo As String * 36
    Dim LogLine As String * 20
    Dim Elapsed As Long                 // the log's time, in seconds
    Dim Sample As Byte                  // ReadAD(AN1)
    Dim NameIn As String * 12           // the folder name typed for C

    LineOne = "What is the meaning of life ?"
    LineTwo = "0123456789ABCDEF0123456789ABCDEF_"

    Dir LOG_INPUT In

    // Prevents the terminal becoming active too early, during reprogramming
    Wait 2 s
    ConsoleCRLF()
    ConsoleLine("CH376 menu demo: the CH376 on UART1, the ch376_sd.h methods")
    ShowMenu()
    DriveReady = 0
    ShowPrompt()

    Do
        If USART2HasData Then
            Key = HSerReceiveFrom(2)
            HSerSend(Key, 2)            // echo the key after the prompt
            If Key >= 97 And Key <= 122 Then Key = Key - 32    // a to z: as A to Z
            Select Case Key
                Case 49                         // 1
                    Heading("1: CHECK THE CH376")
                    CheckDrive()
                Case 50                         // 2
                    Heading("2: MOUNT THE DRIVE")
                    MountDrive()
                Case 51                         // 3
                    Heading("3: START AGAIN")
                    DriveReady = 0
                    StartDrive()
                Case 52                         // 4
                    Heading("4: WRITE " + DEMO_FILE)
                    WriteFile(LineOne)
                Case 53                         // 5
                    Heading("5: READ " + DEMO_FILE)
                    ReadFile()
                Case 54                         // 6
                    Heading("6: ADD A LINE TO " + DEMO_FILE)
                    AppendFile(LineTwo)
                Case 55                         // 7
                    Heading("7: DELETE " + DEMO_FILE)
                    DeleteFile()
                Case 56                         // 8
                    Heading("8: LIST THE FOLDER")
                    ListFolder()
                Case 57                         // 9
                    Heading("9: ADD THE FIRST LINE TO " + DEMO_FILE)
                    AppendFile(LineOne)
                Case 67                         // C
                    Heading("C: CHANGE FOLDER")
                    ChangeFolder()
                Case 76                         // L
                    Heading("L: LOG AN1 TO " + DEMO_FILE + ", ANY KEY STOPS IT")
                    LogInput()
                Case 63                         // ?
                    ShowMenu()
            End Select
            ShowPrompt()                // the job is done: ready for the next key
        End If
    Loop

// ----- The jobs

'''1: reset the CH376 and start the drive, with the chip version and the drive size. The drive is not
'''mounted (2 does that)
Sub CheckDrive
    DriveReady = 0
    If SDCInit() <> SDC_OK Then
        ConsoleText("  FAILED, SDCError ") : ConsoleText(Str(SDCError))
        ConsoleText(", CH376Error 0x") : ConsoleText(Hex(CH376Error)) : ConsoleCRLF()
        If SDCError = SDC_ERR_INIT And CH376Error = CH376_ERR_NO_CHIP Then ConsoleLine("  No answer from the CH376: check TXD, RXD, GND and the baud rate")
        Exit Sub
    End If
    ConsoleText("  CH376 version 0x") : ConsoleText(Hex(CH376Version)) : ConsoleCRLF()
    If SDCCardType = SDC_TYPE_CH376_SD Then
        ConsoleText("  SD card, ")
    Else
        ConsoleText("  USB stick, ")
    End If
    ConsoleText(Str32(SDCBlocks / 2048)) : ConsoleLine(" MB")
End Sub

'''2: mount the drive (after 1) and show its FAT type
Sub MountDrive
    DriveReady = 0
    If FatMount() <> FAT_OK Then
        ConsoleText("  FAILED, FatError ") : ConsoleText(Str(FatError))
        ConsoleLine(" (send 1 first, or 3 to start again)")
        Exit Sub
    End If
    DriveReady = 1
    ConsoleText("  Mounted, FAT") : ConsoleText(Str(FatType)) : ConsoleCRLF()
End Sub

'''3, and before a job when the drive is not started: reset the CH376, start the drive and mount it.
'''Returns 1 when the drive is ready
Function StartDrive As Byte
    StartDrive = DriveReady
    If DriveReady = 1 Then Exit Function
    ConsoleText("  Starting the drive: ")
    If FatInit() <> FAT_OK Then
        If FatError = FAT_ERR_NO_DRIVE Then
            ConsoleText("FAILED, no drive, SDCError ") : ConsoleText(Str(SDCError))
            ConsoleText(", CH376Error 0x") : ConsoleText(Hex(CH376Error)) : ConsoleCRLF()
        Else
            ConsoleText("FAILED, no FAT file system, FatError ") : ConsoleText(Str(FatError)) : ConsoleCRLF()
        End If
        Exit Function
    End If
    ConsoleText("OK, FAT") : ConsoleText(Str(FatType)) : ConsoleCRLF()
    DriveReady = 1
    StartDrive = 1
End Function

'''4: a new file with one line (a file there already is deleted first)
Sub WriteFile(In WFText As String)
    If StartDrive() = 0 Then Exit Sub
    If FatDelete(DEMO_FILE) = FAT_OK Then ConsoleLine("  " + DEMO_FILE + " was there: deleted")
    If FatOpen(DEMO_FILE) <> FAT_OK Then
        JobFailed("open")
        Exit Sub
    End If
    FileLine(WFText)
    If FatCommit() <> FAT_OK Then
        JobFailed("write")
        Exit Sub
    End If
    ConsoleText("  Written, ") : ConsoleText(Str32(FatFileSize)) : ConsoleLine(" bytes")
End Sub

'''6 and 9: add a line at the end of the file (the file is made if it is not there)
Sub AppendFile(In AFText As String)
    If StartDrive() = 0 Then Exit Sub
    If FatOpen(DEMO_FILE) <> FAT_OK Then
        JobFailed("open")
        Exit Sub
    End If
    If FatCreated() = 1 Then ConsoleLine("  " + DEMO_FILE + " was not there: made")
    FileLine(AFText)
    If FatCommit() <> FAT_OK Then
        JobFailed("write")
        Exit Sub
    End If
    ConsoleText("  Added, the file is ") : ConsoleText(Str32(FatFileSize)) : ConsoleLine(" bytes")
End Sub

'''5: the file to the terminal, as it is
Sub ReadFile
    Dim RFByte As Byte
    If StartDrive() = 0 Then Exit Sub
    If FatOpenRead(DEMO_FILE) <> FAT_OK Then
        JobFailed("open")
        Exit Sub
    End If
    ConsoleText("  ") : ConsoleText(Str32(FatFileSize)) : ConsoleLine(" bytes:")
    Do While FatEOF = 0
        RFByte = FatReadByte()
        If FatError <> FAT_OK Then Exit Do
        HSerSend(RFByte, 2)
    Loop
    If FatError <> FAT_OK Then
        ConsoleCRLF()
        JobFailed("read")
        Exit Sub
    End If
    ConsoleLine("  EOF")
End Sub

'''7: delete the file
Sub DeleteFile
    If StartDrive() = 0 Then Exit Sub
    If FatDelete(DEMO_FILE) <> FAT_OK Then
        JobFailed("delete")
        Exit Sub
    End If
    ConsoleLine("  Deleted")
End Sub

'''8: the names in the current folder, with sizes; folders are marked <DIR>
Sub ListFolder
    Dim LFCount As Word
    If StartDrive() = 0 Then Exit Sub
    ConsoleText("  Folder ") : ShowFolder() : ConsoleCRLF()
    LFCount = 0
    If FatListFirst() = 1 Then
        Do
            ConsoleText("  ") : ConsoleText(FatListName)
            If (FatListAttr And FAT_ATTR_DIR) <> 0 Then
                ConsoleLine("  <DIR>")
            Else
                ConsoleText("  ") : ConsoleText(Str32(FatListSize)) : ConsoleLine(" bytes")
            End If
            LFCount++
        Loop While FatListNext() = 1
    End If
    If FatError <> FAT_OK Then
        JobFailed("list")
        Exit Sub
    End If
    ConsoleText("  ") : ConsoleText(Str(LFCount)) : ConsoleLine(" entries")
End Sub

'''C: type a folder name, .. (up one folder) or \ (the root), then Enter, and change to it
Sub ChangeFolder
    If StartDrive() = 0 Then Exit Sub
    ConsoleText("  Folder now ") : ShowFolder() : ConsoleCRLF()
    // a \ in a string is an escape, so the backslash is sent as its character code, 92
    ConsoleText("  Change to (a name, .. or ") : HSerSend(92, 2) : ConsoleText(", then Enter; Esc cancels): ")
    ReadName()
    ConsoleCRLF()
    If NameIn(0) = 0 Then
        ConsoleLine("  Not changed")
        Exit Sub
    End If
    If FatChDir(NameIn) <> FAT_OK Then
        ConsoleText("  FAILED to change to ") : ConsoleText(NameIn) : ConsoleText(", FatError ")
        ConsoleText(Str(FatError))
        If FatError = FAT_ERR_NOT_FOUND Then ConsoleText(" (not found)")
        If FatError = FAT_ERR_NOT_DIR Then ConsoleText(" (a file, not a folder)")
        ConsoleCRLF()
        Exit Sub
    End If
    ConsoleText("  Folder now ") : ShowFolder() : ConsoleCRLF()
End Sub

'''L: every 2 s, "hh:mm:ss,value" to the file, with value = ReadAD(AN1), until a key is sent. The file is
'''opened once; FatCommit after each line puts the line, and the file's size, on the drive
Sub LogInput
    Dim LIWait, LIPart As Byte
    If StartDrive() = 0 Then Exit Sub
    If FatOpen(DEMO_FILE) <> FAT_OK Then
        JobFailed("open")
        Exit Sub
    End If
    Elapsed = 0
    Do
        Sample = ReadAD(AN1)
        // hh:mm:ss,value, a part at a time (one long string expression is too much for the compiler)
        LIPart = Elapsed / 3600
        LogLine = TwoDigits(LIPart) + ":"
        LIPart = (Elapsed / 60) % 60
        LogLine = LogLine + TwoDigits(LIPart) + ":"
        LIPart = Elapsed % 60
        LogLine = LogLine + TwoDigits(LIPart) + ","
        LogLine = LogLine + Str(Sample)
        ConsoleText("  ") : ConsoleText(LogLine)
        FileLine(LogLine)
        If FatCommit() <> FAT_OK Then
            ConsoleCRLF()
            JobFailed("write")
            Exit Sub
        End If
        ConsoleLine("  written")

        // 2 s, in 100 ms steps, so a key stops the log at once
        For LIWait = 1 To 20
            Wait 100 ms
            If USART2HasData Then
                Key = HSerReceiveFrom(2)
                ConsoleLine("  Log stopped")
                Exit Sub
            End If
        Next
        Elapsed = Elapsed + 2
    Loop
End Sub

// ----- Helpers

'''A job failed: say what failed and the FatError, and start the drive again before the next job
Sub JobFailed(In JFWhat As String)
    ConsoleText("  FAILED to ") : ConsoleText(JFWhat) : ConsoleText(" " + DEMO_FILE + ", FatError ")
    ConsoleText(Str(FatError))
    If FatError = FAT_ERR_NOT_FOUND Then ConsoleText(" (not found)")
    ConsoleCRLF()
    // not found is not a drive problem; the others may be (eg the drive pulled out)
    If FatError <> FAT_ERR_NOT_FOUND Then DriveReady = 0
End Sub

'''Read a name from the terminal into NameIn, up to Enter: letters are made capitals (the CH376's 8.3
'''names), Backspace removes the last character, Esc gives an empty name. At most 12 characters
Sub ReadName
    Dim RNChar As Byte
    NameIn = ""
    Do
        Wait Until USART2HasData
        RNChar = HSerReceiveFrom(2)
        If RNChar = 13 Then Exit Sub                        // Enter: done
        If RNChar = 27 Then                                 // Esc: cancel
            NameIn = ""
            Exit Sub
        End If
        If RNChar = 8 Or RNChar = 127 Then                  // Backspace: remove the last character
            If NameIn(0) > 0 Then
                NameIn(0) = NameIn(0) - 1
                HSerSend(8, 2) : HSerSend(32, 2) : HSerSend(8, 2)
            End If
        Else
            If RNChar >= 97 And RNChar <= 122 Then RNChar = RNChar - 32
            If RNChar > 32 And RNChar < 127 And NameIn(0) < 12 Then
                NameIn(0) = NameIn(0) + 1
                NameIn(NameIn(0)) = RNChar
                HSerSend(RNChar, 2)                         // echo
            End If
        End If
    Loop
End Sub

'''The current folder, eg \LOGS\2026, or \ for the root
Sub ShowFolder
    Dim SFPos As Byte
    If FatDirPath(0) = 0 Then
        HSerSend(92, 2)
        Exit Sub
    End If
    For SFPos = 1 To FatDirPath(0)
        If FatDirPath(SFPos) = 47 Then
            HSerSend(92, 2)                                 // the path's / shown as \
        Else
            HSerSend(FatDirPath(SFPos), 2)
        End If
    Next
End Sub

'''A number 0 .. 99 as two digits, eg 07
Function TwoDigits(In TDValue As Byte) As String * 2
    If TDValue < 10 Then
        TwoDigits = "0" + Str(TDValue)
    Else
        TwoDigits = Str(TDValue)
    End If
End Function

'''Add a string and CR LF to the open file
Sub FileLine(In FLString As String)
    Dim FLPos As Byte
    For FLPos = 1 To FLString(0)
        FatAppendByte(FLString(FLPos))
    Next
    FatAppendByte(13)
    FatAppendByte(10)
End Sub

'''The menu
Sub ShowMenu
    ConsoleCRLF()
    ConsoleLine("  1  Check the CH376 and the drive")
    ConsoleLine("  2  Mount the drive")
    ConsoleLine("  3  Start again (reset, start, mount)")
    ConsoleLine("  4  Write " + DEMO_FILE)
    ConsoleLine("  5  Read " + DEMO_FILE)
    ConsoleLine("  6  Add the 33-character line to " + DEMO_FILE)
    ConsoleLine("  7  Delete " + DEMO_FILE)
    ConsoleLine("  8  List the folder")
    ConsoleLine("  9  Add the first line to " + DEMO_FILE)
    ConsoleText("  C  Change folder: a name, .. or ") : HSerSend(92, 2) : ConsoleCRLF()
    ConsoleLine("  L  Log AN1 to " + DEMO_FILE + " every 2 s (any key stops it)")
    ConsoleLine("  ?  This menu")
End Sub

'''The prompt: a new line and "> ", ready for a key
Sub ShowPrompt
    ConsoleCRLF()
    ConsoleText("> ")
End Sub

'''The heading of a job
Sub Heading(In HDText As String)
    ConsoleCRLF()
    ConsoleLine("======================")
    ConsoleLine(HDText)
    ConsoleLine("----------------------")
End Sub

'''Send a string to the terminal
Sub ConsoleText(In ConsoleString As String)
    HSerPrint ConsoleString, 2
End Sub

'''Send a string and CR LF to the terminal
Sub ConsoleLine(In ConsoleString As String)
    HSerPrint ConsoleString, 2
    HSerPrintCRLF 1, 2
End Sub

'''End the terminal line: CR LF
Sub ConsoleCRLF
    HSerPrintCRLF 1, 2
End Sub
