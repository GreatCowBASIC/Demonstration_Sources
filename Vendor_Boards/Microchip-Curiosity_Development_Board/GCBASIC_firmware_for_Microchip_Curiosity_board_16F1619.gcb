/*
A demonstration program for GCBASIC.
--------------------------------------------------------------------------------
 This program recreation of Microchip Curiosity firmware for the 16F1619

 Microchip Curiosity 8/14/20 pin 8 bit demo board
  o PIC16F1619
  o LEDs D4-D7 on RA5, RA1/PGEC, RA2, RC5
  o Switch SWITCH1 on RC4
  o Switch S2 on RA3/MCLRE
  o Touch Switch S3 on RC1/AN5
  o Potentiometer POT1 on RC0/AN4

 Capacitive Voltage Divider (CVD) – AN1298

 On startup LEDs D4-D7 turn on and off
 LED D6 turns on while S3 is touched
 LED D7 is the PWM signal
 LED D4 turns on when S1 is pressed



The touch sensing follows Microchip's own Curiosity firmware (Curiosity_Development_Board_rev2_Original_Firmware.hex,
disassembled): a two-phase differential CVD reading on the pad pin RC1/AN5 alone, no second pin.
    Phase A: the hold capacitor (CHOLD) is charged high through the pad, isolated, the pad is driven low, then pad
             and CHOLD share their charge and the ADC converts at once.
    Phase B: the same with the polarities swapped. Reading = A - B + 1024: a touch raises it, noise common to both
             phases cancels.
    Each reading moves a slew-limited value by at most 1; eight of those are summed.
    Press when the sum is 250 above the baseline, release below 125 (hysteresis). The baseline is the first sum,
    then follows the sum slowly (/16) only while the pad is released.



@author    Evan R. Venn (original) + fixes
@license   GPL
@version   1.05

1.04  The CVD result is read from ADRESH:ADRESL (ReadAD10 started a second, ordinary conversion and the
      charge-sharing value was lost); ReleaseCount is a global started at 0 (the "Dim ... = 0" inside the routine
      reset it on every pass, so the baseline never moved after learning); the slow baseline filter is worked out
      in a Long (baseline * 127 overflowed a Word)
1.05  Touch sensing rewritten to Microchip's two-phase differential CVD on RC1/AN5 only (RC2/AN6 no longer used),
      with its slew-limited 8-sample sum, press 250 / release 125 hysteresis and /16 baseline while released;
      the pad is driven again only after each conversion (with the Fosc/32 ADC clock, driving it straight after GO
      overwrote the reading); the first reading is taken after the start-up flash;
      reading A - B (B - A fell with a touch on the Curiosity board: D6 inverted)
*/


// ---- Configuration
#CHIP 16F1619, 32
#CONFIG MCLRE_ON

#startup InitPPS, 85
#define PPSToolPart 16f1619

Sub InitPPS
    RC5PPS = 0x000E          //PWM3OUT > RC5
End Sub

#OPTION Explicit

// ---- Hardware
#DEFINE SWITCH1 PORTC.4
Dir SWITCH1 In

#DEFINE LED4 PORTA.5
Dir PORTA.5 Out

#DEFINE LED5 PORTA.1
Dir PORTA.1 Out

#DEFINE LED6 PORTA.2
Dir PORTA.2 Out

#DEFINE LED7 PORTC.5
Dir PORTC.5 Out

#DEFINE POT1 AN4
Dir PORTC.0 In

#DEFINE WAITSECS 1

// ---- Variables
Dim PWMSetCounter As Word
PWMSetCounter = 0

// Touch: the slew-limited reading, the sum of 8 of them, the baseline, and the state (0 start, 1 released, 2 pressed)
Dim TouchFiltered As Word
Dim TouchSum As Word
Dim TouchBaseline As Word
Dim TouchState As Byte

// The pad: an output (driven low between measurements), analog
Set ANSELC.1 = 1
Set LATC.1 = 0
Dir PORTC.1 Out
TouchFiltered = 0
TouchSum = 0
TouchBaseline = 0
TouchState = 0

// ---- Main
Wait WAITSECS s
Set LED4 = 1
Set LED5 = 1
Set LED6 = 1
Set LED7 = 1
Wait WAITSECS s
Set LED7 = 0
Set LED6 = 0
Set LED5 = 1
Set LED4 = 0

// The pad has settled during the start-up flash: the slew-limited value starts at a real reading. Keep off the pad
// now - the first sum (ReadmTouch) becomes the baseline
TouchFiltered = CVDRead

#DEFINE HPWM_FAST
Dim PWMDutyValue As Byte
Dim PWMDirection As Integer
PWMDirection = 1
PWMDutyValue = 127
HPWM 3, 3, PWMDutyValue, 2

Do Forever

    LED4 = !SWITCH1

    If PWMSetCounter MOD 64 = 0 Then
        HPWMUpdate 3, ReadAD(AN4)

        PWMDutyValue = PWMDutyValue + PWMDirection
        If PWMDutyValue = 255 Then
            PWMDirection = -1
        Else If PWMDutyValue = 0 Then
            PWMDirection = 1
        End If

        ReadmTouch
    End If

    PWMSetCounter++

Loop

// ---- CVD touch (as Microchip's Curiosity firmware)
//
// ADCON0 values: CVD_PAD selects AN5 (the pad, RC1) with the ADC on; CVD_ISOLATE selects channel 16, an input with
// nothing on it, so CHOLD keeps its charge while the pad is set the other way.
#DEFINE CVD_PAD      0x15
#DEFINE CVD_ISOLATE  0x41
// ADCON1: right justified, ADC clock Fosc/32 (1 us at 32 MHz). Microchip's firmware uses Fosc/2 (0x80), out of spec
// at 32 MHz; the pad is left alone until the conversion is done (see CVDRead), so the slower clock is safe
#DEFINE CVD_ADCON1   0xA0
// Hysteresis on the 8-sample sum above the baseline (Microchip's values)
#DEFINE TOUCH_PRESS    250
#DEFINE TOUCH_RELEASE  125

Function CVDRead As Word
    // One differential reading: phase A - phase B + 1024 (a touch raises it on this board). Microchip's sequence: no waits - the
    // conversion starts as soon as CHOLD is connected to the pad. Microchip drives the pad again straight after GO, which
    // is safe only with its Fosc/2 ADC clock: the sample is taken one ADC clock after GO, so with Fosc/32 (1 us) the
    // pad was still connected and its drive overwrote the shared voltage (D6 stuck on, or inverted). The pad is driven
    // again here once the conversion is done, safe with any ADC clock
    Dim CVDPhaseA, CVDPhaseB As Word
    Dim CVDSaveADCON1 As Byte
    CVDSaveADCON1 = ADCON1
    ADCON1 = CVD_ADCON1
    IntOff

    // Phase A: CHOLD charged high through the pad, isolated, pad low, then share and convert
    Set LATC.1 = 1
    ADCON0 = CVD_PAD
    ADCON0 = CVD_ISOLATE
    Set LATC.1 = 0
    Set TRISC.1 = 1
    ADCON0 = CVD_PAD
    Set ADCON0.GO = 1
    Wait While ADCON0.GO = 1
    Set LATC.1 = 1
    Set TRISC.1 = 0
    CVDPhaseA = ADRESL
    CVDPhaseA_H = ADRESH

    // Phase B: CHOLD discharged through the pad, isolated, pad high, then share and convert
    Set LATC.1 = 0
    ADCON0 = CVD_PAD
    ADCON0 = CVD_ISOLATE
    Set LATC.1 = 1
    Set TRISC.1 = 1
    ADCON0 = CVD_PAD
    Set ADCON0.GO = 1
    Wait While ADCON0.GO = 1
    Set LATC.1 = 0
    Set TRISC.1 = 0
    CVDPhaseB = ADRESL
    CVDPhaseB_H = ADRESH

    IntOn
    ADCON1 = CVDSaveADCON1
    ADCON0.ADON = 0
    CVDRead = CVDPhaseA - CVDPhaseB + 1024
End Function

Sub ReadmTouch
    // Eight readings, each moving the slew-limited value by at most 1, summed; then the press / release decision and,
    // while released, the slow baseline
    Dim TouchCount As Byte
    Dim TouchRaw, TouchDelta As Word

    TouchSum = 0
    For TouchCount = 1 To 8
        TouchRaw = CVDRead
        If TouchRaw > TouchFiltered Then TouchFiltered++
        If TouchRaw < TouchFiltered Then TouchFiltered--
        TouchSum = TouchSum + TouchFiltered
    Next

    // How far above the baseline (0 when below)
    TouchDelta = 0
    If TouchSum > TouchBaseline Then TouchDelta = TouchSum - TouchBaseline

    Select Case TouchState
        Case 0
            // Start: the first sum is the baseline
            TouchBaseline = TouchSum
            TouchState = 1
        Case 1
            If TouchDelta >= TOUCH_PRESS Then TouchState = 2
        Case 2
            If TouchDelta < TOUCH_RELEASE Then TouchState = 1
    End Select

    // The baseline follows slowly (1/16 of the difference), only while the pad is released
    If TouchState = 1 Then TouchBaseline = TouchBaseline - TouchBaseline / 16 + TouchSum / 16

    LED6 = 0
    If TouchState = 2 Then LED6 = 1
End Sub

// ---- ADC optimisation (must enable AN5)
#DEFINE USE_AD0 FALSE
#DEFINE USE_AD1 FALSE
#DEFINE USE_AD2 TRUE
