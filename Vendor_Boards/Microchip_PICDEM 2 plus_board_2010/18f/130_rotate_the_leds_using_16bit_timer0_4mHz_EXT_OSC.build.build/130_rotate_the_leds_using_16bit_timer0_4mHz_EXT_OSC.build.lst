 28766                           
 28767                           ;Config register CONFIG1 @ 0x300000
 28768                           ;	External Oscillator Selection
 28769                           ;	FEXTOSC = OFF, Oscillator not enabled.
 28770                           ;	Reset Oscillator Selection
 28771                           ;	RSTOSC = EXTOSC, EXTOSC operating per FEXTOSC bits (device manufacturing default)
 28772                           ;	CPU Halt bit
 28773                           ;	CPUHALT = OFF, CPU operates normally after loading the Configurable Logic Block (CLB)/Special Function Register (SFR) image
 28774   300000                     	org	3145728
 28775   300000  F6                 	db	246
 28776                           
 28777                           ;Config register CONFIG2 @ 0x300001
 28778                           ;	Clock out Enable bit
 28779                           ;	CLKOUTEN = OFF, CLKOUT function is disabled
 28780                           ;	PRLOCKED One-Way Set Enable bit
 28781                           ;	PR1WAY = OFF, PRLOCKED bit can be set and cleared repeatedly
 28782                           ;	Boot Block enable bit
 28783                           ;	BBEN = OFF, Boot block disabled
 28784                           ;	Clock Switch Enable bit
 28785                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 28786                           ;	CLB Configuration on Start-up
 28787                           ;	CLBSU = ON, The CLB will be automatically configured during device configuration
 28788                           ;	Fail-Safe Clock Monitor Enable bit
 28789                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 28790                           ;	Fail-Safe Clock Monitor - Primary XTAL Enable bit
 28791                           ;	FCMENP = OFF, Fail-Safe Clock Monitor Disabled
 28792                           ;	Fail-Safe Clock Monitor - Secondary XTAL Enable bit
 28793                           ;	FCMENS = OFF, Fail-Safe Clock Monitor Disabled
 28794   300001                     	org	3145729
 28795   300001  2D                 	db	45
 28796                           
 28797                           ;Config register CONFIG3 @ 0x300002
 28798                           ;	MCLR Enable bit
 28799                           ;	MCLRE = INTMCLR, If LVP = 0, MCLR pin function is port defined function; If LVP =1, RE3 pin fuction is MCLR
 28800                           ;	Power-up timer selection bits
 28801                           ;	PWRTS = PWRT_OFF, PWRT is disabled
 28802                           ;	Multi-vector enable bit
 28803                           ;	MVECEN = OFF, Interrupt contoller does not use vector table to prioritze interrupts
 28804                           ;	IVTLOCK bit One-way set enable bit
 28805                           ;	IVT1WAY = OFF, IVTLOCKED bit can be cleared and set repeatedly
 28806                           ;	Low Power BOR Enable bit
 28807                           ;	LPBOREN = OFF, Low-Power BOR disabled
 28808                           ;	Brown-out Reset Enable bits
 28809                           ;	BOREN = OFF, Brown-out Reset disabled
 28810   300002                     	org	3145730
 28811   300002  26                 	db	38
 28812                           
 28813                           ;Config register CONFIG4 @ 0x300003
 28814                           ;	Brown-out Reset Voltage Selection bits
 28815                           ;	BORV = VBOR_2P85, Brown-out Reset Voltage (VBOR) set to 2.85V
 28816                           ;	ZCD1 Disable bit
 28817                           ;	ZCD1 = ON, ZCD1 module is always enabled; ZCDMD and ZCDSEN bits are ignored
 28818                           ;	PPSLOCK bit One-Way Set Enable bit
 28819                           ;	PPS1WAY = OFF, PPSLOCKED bit can be set and cleared repeatedly (subject to the unlock sequence)
 28820                           ;	Stack Full/Underflow Reset Enable bit
 28821                           ;	STVREN = OFF, Stack full/underflow will not cause Reset
 28822                           ;	Low Voltage Programming Enable bit
 28823                           ;	LVP = OFF, HV on MCLR/VPP must be used for programming
 28824                           ;	Background Debugger
 28825                           ;	DEBUG = OFF, Background Debugger disabled
 28826                           ;	Extended Instruction Set Enable bit
 28827                           ;	XINST = OFF, Extended Instruction Set and Indexed Addressing Mode disabled
 28828   300003                     	org	3145731
 28829   300003  C0                 	db	192
 28830                           
 28831                           ;Config register CONFIG5 @ 0x300004
 28832                           ;	WDT Period selection bits
