 28368   0000DC  C504 F2B8          	movff	1284,696
 28369   0000E0  0012               	return	
 28370   0000E2                     INITPPS:
 28371                           	callstack 0
 28372                           
 28373                           ;'MODULE: UART PIN DIRECTIONS
 28374                           ;'DIR PORTC.6 OUT    ' MAKE TX1 PIN AN OUTPUT
 28375   0000E2  0101               	banksel	330
 28376   0000E4  9D4A               	bcf	330,6,b
 28377                           
 28378                           ;'MODULE: UART1
 28379                           ;'U1RXPPS = 0X15; //RC5->UART1:RX1;
 28380   0000E6  0E15               	movlw	21
 28381   0000E8  0102               	banksel	626
 28382   0000EA  6F72               	movwf	626,b
 28383                           
 28384                           ;'RC6PPS = 0X12;  //RC6->UART1:TX1;
 28385   0000EC  0E12               	movlw	18
 28386   0000EE  6F17               	movwf	535,b
 28387   0000F0  0100               	banksel	0
 28388   0000F2  0012               	return	
 28389   0000F4                     INITSYS:
 28390                           	callstack 0
 28391                           
 28392                           ;'CLEAR BSR ON CHIPFAMILY16 MCUS
 28393                           ;'MOVLB 0
 28394   0000F4  0100               	movlb	0
 28395                           
 28396                           ;'DEFAULT SETTINGS FOR MICROCONTROLLERS WITH _OSCCON1_
 28397                           ;DEFAULT OSCCON1,NOSC HFINTOSC; NDIV 1 - COMMON AS THIS SIMPLY SETS THE HFINTOSC
 28398                           ;'OSCCON1 = 0X60
 28399   0000F6  0E60               	movlw	96
 28400   0000F8  6FAD               	movwf	173,b
 28401                           
 28402                           ;'DEFAULT VALUE TYPICALLY, CSWHOLD MAY PROCEED; SOSCPWR LOW POWER
 28403                           ;'OSCCON3 = 0X00
 28404   0000FA  6BAF               	clrf	175,b
 28405                           
 28406                           ;'DEFAULT VALUE TYPICALLY, MFOEN DISABLED; LFOEN DISABLED; ADOEN DISABLED; SOSCEN DISABLED; EXTOEN DISABLED; HFOEN DISABLED
 28407                           ;'OSCEN = 0X00
 28408   0000FC  6BB3               	clrf	179,b
 28409                           
 28410                           ;'DEFAULT VALUE
 28411                           ;'OSCTUNE = 0X00
 28412   0000FE  6BB0               	clrf	176,b
 28413                           
 28414                           ;'THE MCU IS A CHIP FAMILY 16
 28415                           ;'SECTION SUPPORTS MANY MCUS, 18FXXK40, 18FXXK42 ETC THAT HAVE NDIV3 BIT
 28416                           ;'OSCCON TYPE IS 101
 28417                           ;'OSCCON1 = 0X60          // SETTING OSCCON1 IMPLIES CLEARING CLEAR NDIV3:0
 28418   000100  0E60               	movlw	96
 28419   000102  6FAD               	movwf	173,b
 28420                           
 28421                           ;'OSCFRQ = 0B00000010    '4MHZ
