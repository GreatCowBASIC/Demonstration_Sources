 28834                           ;	WDT operating mode
 28835                           ;	WDTE = OFF, WDT Disabled; SEN is ignored
 28836   300004                     	org	3145732
 28837   300004  80                 	db	128
 28838                           
 28839                           ;Config register CONFIG6 @ 0x300005
 28840                           ;	WDT Window Select bits
