 28099                           ;'START_OF_THE_MAIN_PROGRAM
 28100                           ;'
 28101                           ;'THIS DEMONSTRATION FLASHES AN LED TO SHOW THE USE OF A 16BIT TIMER 1
 28102                           ;'
 28103                           ;'THIS LESSON CONFIGURES TIMER0 TO COUNT INSTRUCTION CYCLES AND TO SET A FLAG WHEN IT ROLLS
 28104                           ;'OVER. THIS FREES UP THE PROCESSOR TO DO MEANINGFUL WORK RATHER THAN WASTING INSTRUCTION
 28105                           ;'CYCLES IN A TIMING LOOP USING A 16BIT TIMER.
 28106                           ;'USING A COUNTER PROVIDES A CONVENIENT METHOD OF MEASURING TIME OR DELAY LOOPS AS IT
 28107                           ;'ALLOWS THE PROCESSOR TO WORK ON OTHER TASKS RATHER THAN COUNTING INSTRUCTION CYCLES.
 28108                           ;'
 28109                           ;'LEDS SHOULD FLASH  ~1 SECOND.
 28110                           ;'
 28111                           ;'------------------------------------------------------------------------
 28112                           ;'IMPORTANT - POWER CONFIGURATION
 28113                           ;'------------------------------------------------------------------------
 28114                           ;'!! VDDIO2 IS CRITICAL FOR OPERATION !!
 28115                           ;'ON THIS DEVICE FAMILY, VDDIO2 SUPPLIES POWER TO A SECONDARY I/O BANK.
 28116                           ;'IF VDDIO2 IS NOT CORRECTLY CONNECTED TO THE SUPPLY RAIL (PER THE
 28117                           ;'DATASHEET ELECTRICAL AND PIN-OUT SPECIFICATIONS), THE ASSOCIATED I/O
 28118                           ;'PINS WILL NOT FUNCTION CORRECTLY, AND THE CHIP MAY NOT OPERATE
 28119                           ;'RELIABLY EVEN THOUGH THE PRIMARY VDD/VSS PINS ARE POWERED CORRECTLY.
 28120                           ;'ALWAYS VERIFY VDDIO2 IS WIRED TO VDD (OR THE CORRECT SUPPLY LEVEL) ON
 28121                           ;'YOUR BOARD BEFORE TROUBLESHOOTING "DEAD" I/O OR UNEXPECTED RESETS.
 28122                           ;'------------------------------------------------------------------------
 28123                           ;'
 28124                           ;'
 28125                           ;'CHIP SETTINGS
 28126                           ;'! THE TIMER CALCULATIONS ARE BASED ON 4MHZ EXTERNAL OSCILLATOR
 28127                           ;'! YOU WOULD NEED TO RECALCULATE THE TIMER VALUES IF 4MHZ IS NOT USED
 28128                           ;'SET MICROCONTROLLER REQUIRED
 28129                           ;'
 28130                           ;'------------PORTA---------------
 28131                           ;'BIT#:  -7---6---5---4---3---2---1---0---
 28132                           ;'IO:    ------------SW--------------ADC--
 28133                           ;'IO:    ---------------------------------
 28134                           ;'
 28135                           ;'------------PORTB----------------
 28136                           ;'BIT#:  -7---6---5---4---3---2---1---0---
 28137                           ;'IO:    ----------------LED-LED-LED-LED--
 28138                           ;'IO:    ---------------------------------
 28139                           ;'
 28140                           ;'------------PORTC----------------
 28141                           ;'BIT#:  -7---6---5---4---3---2---1---0---
 28142                           ;'IO:    VDD------------------------------
 28143                           ;'IO:    ---------------------------------
 28144                           ;'
 28145                           ;'------------PORTD----------------
 28146                           ;'BIT#:  -7---6---5---4---3---2---1---0---
 28147                           ;'IO:    PWR-EN--RW--RS--DB7-DB6-DB5-DB4--
 28148                           ;'IO:    ---------------------------------
 28149                           ;'
 28150                           ;'------------PORTE----------------
 28151                           ;'BIT#:  -7---6---5---4---3---2---1---0---
 28152                           ;'IO:    ----------------RST---------------
 28153                           ;'IO:    ---------------------------------
 28154                           ;'
 28155                           ;'PIC PPS TOOL VERSION: 0.0.6.5
 28156                           ;'DEFINE CONSTANTS TO MAKE THINGS EASIER. WE CAN REUSE A CONSTANT AT ANY TIME.
 28157                           ;'DIR     LEDD0 OUT
 28158   000012  0101               	banksel	329
 28159   000014  9149               	bcf	329,0,b
 28160                           
 28161                           ;'DIR     LEDD1 OUT
 28162   000016  9349               	bcf	329,1,b
 28163                           
 28164                           ;'DIR     LEDD2 OUT
 28165   000018  9549               	bcf	329,2,b
 28166                           
 28167                           ;'DIR     LEDD3 OUT
 28168   00001A  9749               	bcf	329,3,b
 28169                           
 28170                           ;'THIS IS THE PORTA.0 PORT
 28171                           ;'DIR POTENTIOMETER IN
 28172   00001C  8148               	bsf	328,0,b
 28173                           
 28174                           ;'DIR     SWITCHIN      IN
 28175   00001E  8948               	bsf	328,4,b
 28176                           
 28177                           ;'DIR RSTBUTTON IN // THIS IS SET AUTOMATICALLY - AND, YOU CANNOT SET AS AN OUTPUT
 28178   000020  874C               	bsf	332,3,b
 28179                           
 28180                           ;'! SPECIFY EXPLICIT OCULAR_OM1614 SUPPORT!!
 28181                           ;'SETUP LCD PARAMETERS
 28182                           ;'DEFINE LCD HARDWARE SETTINGS
 28183                           ;'! REQUIRED FOR OCULAR LCD DRIVER
 28184                           ;'*****************************************************************************************************
 28185                           ;'MAIN PROGRAM COMMENCES HERE.. EVERYTHING BEFORE THIS IS SETUP FOR THE BOARD.
 28186                           ;'INITIALISE THE TIMER.
 28187                           ;'FIRSTLY TELL THE COMPILER TO USE A 16BIT TIMER FOR THIS PROGRAM
 28188                           ;'FOR THIS WE NEED THE FOLLOWING FOR TIMER0
 28189                           ;'FOSC = 4 MHZ � INSTRUCTION CLOCK = FOSC/4 = 1 MHZ � TCY = 1 µS
 28190                           ;'PRESCALER 1:64 � EACH TIMER0 TICK = 64 × 1 µS = 64 µS
 28191                           ;'16-BIT MODE, PRELOAD = 49911 (0XC2B7)
 28192                           ;COUNTS ,6,625
 28193                           ;'PERIOD = 15,625 × 64 µS = 1,000,000 µS = 1.000 S
 28194                           ;'INITTIMER0 OSC, PRE0_64 + TMR0_FOSC4 ,  POST0_1
 28195   000022  0E01               	movlw	1
 28196   000024  6E11               	movwf	1297,c
 28197   000026  0E46               	movlw	70
 28198   000028  6E10               	movwf	1296,c
 28199   00002A  6A0F               	clrf	1295,c
 28200   00002C  0100               	banksel	0
 28201   00002E  D880               	rcall	INITTIMER0199
 28202                           
 28203                           ;'EVERY 1 SEC.
 28204                           ;'SETTIMER ( 0 , 49911 )
 28205   000030  6A0E               	clrf	1294,c
 28206   000032  0EF7               	movlw	247
 28207   000034  6E12               	movwf	1298,c
 28208   000036  0EC2               	movlw	194
 28209   000038  6E13               	movwf	1299,c
 28210   00003A  D89C               	rcall	SETTIMER197
 28211                           
 28212                           ;'START THE TIMER
 28213                           ;'STARTTIMER 0
 28214   00003C  6A0E               	clrf	1294,c
 28215   00003E  D8BC               	rcall	STARTTIMER
 28216                           
 28217                           ;'CREATE BYTE VARIABLE AS A FLAG
 28218                           ;'DIM TIMEOUT AS BIT
 28219                           ;'INITIALIZE A VARIABLE TO HOLD THE LED STATES
 28220                           ;'DIM LEDS AS BYTE
 28221                           ;'LEDS = 0B0001  // START WITH THE FIRST LED ON
 28222   000040  0E01               	movlw	1
 28223   000042  6E01               	movwf	1281,c
 28224                           
 28225                           ;'INITIALIZE A COUNTER FOR ROTATIONS
 28226                           ;'DIM ROTATECOUNT AS BYTE
 28227                           ;'ROTATECOUNT = 0
 28228   000044  6A03               	clrf	1283,c
 28229   000046                     SYSDOLOOP_S1:
 28230                           	callstack 0
 28231   000046                     SYSWAITLOOP1:
 28232                           	callstack 0
 28233   000046  A6BE               	btfss	1214,3,c
 28234   000048  D7FE               	bra	SYSWAITLOOP1
 28235                           
 28236                           ;'CLEARING TIMER 0 FLAG WILL RESET EVENT
 28237                           ;'TMR0IF = 0
 28238   00004A  96BE               	bcf	1214,3,c
 28239                           
 28240                           ;'HSERPRINTSTRINGCRLF "."
 28241   00004C  EE15 F0FD          	lfsr	1,5373
 28242   000050  0E1A               	movlw	low STRINGTABLE1
 28243   000052  6EF6               	movwf	tblptrl,c
 28244   000054  0E02               	movlw	high STRINGTABLE1
 28245   000056  6EF7               	movwf	tblptrh,c
 28246   000058  0E00               	movlw	low (STRINGTABLE1 shr (0+16))
 28247   00005A  6EF8               	movwf	tblptru,c
 28248   00005C  D8CB               	rcall	SYSREADSTRING
 28249   00005E  0EFD               	movlw	253
 28250   000060  6E0A               	movwf	1290,c
 28251   000062  0E14               	movlw	20
 28252   000064  6E0B               	movwf	1291,c
 28253   000066  0E01               	movlw	1
 28254   000068  6E00               	movwf	1280,c
 28255                           
 28256                           ;'USING SYSSTRINGPARAM1*1
 28257   00006A  D814               	rcall	HSERPRINTSTRINGCRLF
 28258                           
 28259                           ;'OUTPUT THE CURRENT STATE TO PORTB
 28260                           ;'LATB = LEDS
 28261   00006C  C501 F141          	movff	1281,321
 28262                           
 28263                           ;'ROTATE THE LEDS TO THE LEFT
 28264                           ;'ROTATE LEDS LEFT SIMPLE
 28265   000070  4601               	rlncf	1281,f,c
 28266                           
 28267                           ;'INCREMENT THE ROTATION COUNTER
 28268                           ;'ROTATECOUNT = ROTATECOUNT + 1
 28269   000072  2A03               	incf	1283,f,c
 28270                           
 28271                           ;'RESET THE LEDS AFTER 4 ROTATIONS
 28272                           ;'IF ROTATECOUNT >= 4 THEN
 28273   000074  0E04               	movlw	4
 28274   000076  5C03               	subwf	1283,w,c
 28275   000078  A0D8               	btfss	status,0,c
 28276   00007A  D003               	bra	ENDIF1
 28277                           
 28278                           ;'LEDS = 0B0001  // RESET TO INITIAL STATE
 28279   00007C  0E01               	movlw	1
 28280   00007E  6E01               	movwf	1281,c
 28281                           
 28282                           ;'ROTATECOUNT = 0  // RESET COUNTER
 28283   000080  6A03               	clrf	1283,c
 28284   000082                     ENDIF1:
 28285                           	callstack 0
 28286                           
 28287                           ;'SET TIMER. THIS VALUE AS CLOSE AS YOU CAN GET TO 1S
 28288                           ;'SETTIMER ( 0 , 49911 )
 28289   000082  6A0E               	clrf	1294,c
 28290   000084  0EF7               	movlw	247
 28291   000086  6E12               	movwf	1298,c
 28292   000088  0EC2               	movlw	194
 28293   00008A  6E13               	movwf	1299,c
 28294   00008C  D873               	rcall	SETTIMER197
 28295                           
 28296                           ;'LOOP
 28297   00008E  D7DB               	bra	SYSDOLOOP_S1
 28298   000090                     SYSDOLOOP_E1:
 28299                           	callstack 0
 28300   000090                     BASPROGRAMEND:
 28301                           	callstack 0
 28302   000090  0003               	sleep	
 28303   000092  D7FE               	bra	BASPROGRAMEND
 28304   000094                     HSERPRINTSTRINGCRLF:
 28305                           	callstack 0
 28306                           
 28307                           ;'PRINTLEN = PRINTDATA(0)
 28308   000094  C50A F4E9          	movff	1290,fsr0l
 28309   000098  C50B F4EA          	movff	1291,fsr0h
 28310   00009C  C4EF F502          	movff	indf0,1282
 28311                           
 28312                           ;'IF PRINTLEN <> 0 THEN
 28313   0000A0  5202               	movf	1282,f,c
 28314   0000A2  B4D8               	btfsc	status,2,c
 28315   0000A4  D013               	bra	ENDIF13
 28316                           
 28317                           ;'WRITE DATA
 28318                           ;'FOR SYSPRINTTEMP = 1 TO PRINTLEN
 28319                           ;'LEGACY METHOD
 28320   0000A6  6A0C               	clrf	1292,c
 28321   0000A8  0E01               	movlw	1
 28322   0000AA  5C02               	subwf	1282,w,c
 28323   0000AC  A0D8               	btfss	status,0,c
 28324   0000AE  D00E               	bra	SYSFORLOOPEND1
 28325   0000B0                     SYSFORLOOP1:
 28326                           	callstack 0
 28327   0000B0  2A0C               	incf	1292,f,c
 28328                           
 28329                           ;'HSERSEND(PRINTDATA(SYSPRINTTEMP),COMPORT )
 28330   0000B2  500C               	movf	1292,w,c
 28331   0000B4  240A               	addwf	1290,w,c
 28332   0000B6  6EE9               	movwf	fsr0l,c
 28333   0000B8  0E00               	movlw	0
 28334   0000BA  200B               	addwfc	1291,w,c
 28335   0000BC  6EEA               	movwf	fsr0h,c
 28336   0000BE  C4EF F504          	movff	indf0,1284
 28337   0000C2  D80A               	rcall	HSERSEND345
 28338                           
 28339                           ;'NEXT
 28340   0000C4  5002               	movf	1282,w,c
 28341   0000C6  5C0C               	subwf	1292,w,c
 28342   0000C8  A0D8               	btfss	status,0,c
 28343   0000CA  D7F2               	bra	SYSFORLOOP1
 28344   0000CC                     SYSFORLOOPEND1:
 28345                           	callstack 0
 28346   0000CC                     ENDIF13:
 28347                           	callstack 0
 28348                           
 28349                           ;'HSERSEND(13,COMPORT)
 28350   0000CC  0E0D               	movlw	13
 28351   0000CE  6E04               	movwf	1284,c
 28352   0000D0  D803               	rcall	HSERSEND345
 28353                           
 28354                           ;'HSERSEND(10,COMPORT)
 28355   0000D2  0E0A               	movlw	10
 28356   0000D4  6E04               	movwf	1284,c
 28357   0000D6  D000               	bra	HSERSEND345
 28358   0000D8                     HSERSEND345:
 28359                           	callstack 0
 28360   0000D8                     HSERSENDUSART1HANDLER:
 28361                           	callstack 0
