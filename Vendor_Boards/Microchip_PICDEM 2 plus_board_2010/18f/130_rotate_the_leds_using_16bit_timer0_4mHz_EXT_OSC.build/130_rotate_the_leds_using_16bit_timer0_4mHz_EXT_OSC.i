ELSIF(auto_size ge 4)
movlw low(auto_size)
addwf FSR1L,c
movlw high(auto_size)
addwfc FSR1H,c
ENDIF
ENDIF
ENDIF
ENDIF
ENDM


; restore_stack adjusts the SP to remove all auto and parameter
; objects from the stack prior to returning from a function

restore_stack MACRO
movlw low(stk_offset)
addwf FSR1L,c
movlw high(stk_offset)
addwfc FSR1H,c
stk_offset SET 0
auto_size SET 0
