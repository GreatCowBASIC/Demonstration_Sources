#SKIPTEST
#chip mega328p, 16

'Repeat For test (Change 1654): Rejected: compound And condition
'Expect: compile error (this file is marked #SKIPTEST so the demo sweep ignores it):
'  Repeat For cannot use this construct inside its body because its timing is not fixed: a Call, a Wait with a variable time, Goto, Gosub, Exit Sub, Exit

#option explicit
Dim Flag As Bit
Dim Cnt As Byte
Dim Xv As Byte
Dim Yv As Byte
Flag = 1
Xv = 200
Yv = 1
Cnt = 0
Repeat For 20 ms
    If Xv = 1 And Flag = 0 Then
        Yv = 0
    End If
End Repeat
Do
Loop
