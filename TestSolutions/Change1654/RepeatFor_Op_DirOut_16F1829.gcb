#chip 16F1829, 8

'Repeat For test (Change 1654): Body operation: Dir statement in the body, on 16F1829
'Expect: compiles, and the whole Repeat For construct runs exactly 40,000 clock cycles
'(checked by simulating the generated assembly instruction by instruction)

#option explicit
Dim Flag As Bit
Dim Cnt As Byte
Dim X As Byte
Dim Y As Byte
Dim W1 As Word
Dim W2 As Word
Dim S1 As String
Dim Buf(8) As Byte
Table Tbl
    1, 2, 3
End Table
Sub Tick
    X = X + 1
End Sub
Function Plus1(Av As Byte) As Byte
    Plus1 = Av + 1
End Function
Repeat For 20 ms
    Dir PORTC.0 Out
End Repeat
Do
Loop
