  2671                           ;'SO IT MUST BE HANDLED OUTSIDE THE IRCF BASED TYPE 103 SECTION
  2672                           ;'TYPE 103: CHIPS WITHOUT SPLLEN, IRCF3, BUT MUST HAVE AT LEAST IRCF2 (EXCLUDE 2-BIT IRCF CHIPS)
  2673                           ;'OSCCON TYPE IS 105 'BIT(((OSCCON) and 07Fh), 7) OR BIT(((OSCCON) and 07Fh), 6) AND NOBIT(INTSRC) AND IFDEF BIT(((OSCCON) and 07Fh), 6)
  2674                           ;'EQUATES TO OSCCON = OSCCON AND B'10000111' &  OSCCON = OSCCON OR B'01110000'
  2675                           ;'= 8MHZ
