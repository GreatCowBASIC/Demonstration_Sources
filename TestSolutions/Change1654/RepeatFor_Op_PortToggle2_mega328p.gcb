#chip mega328p, 16

'Repeat For test (Change 1654): Body operation: port bit assignments, on mega328p
'Expect: compiles, and the whole Repeat For construct runs exactly 320,000 clock cycles
'(checked by simulating the generated assembly instruction by instruction)

#option explicit
Dim Flag As Bit
Dim Cnt As Byte
Dim X As Byte
Dim Y As Byte
Dim W1 As Word
Dim W2 As Word
Dim S1 As String
Dim Buf(8) As Byte
Table Tbl
    1, 2, 3
End Table
Sub Tick
    X = X + 1
End Sub
Function Plus1(Av As Byte) As Byte
    Plus1 = Av + 1
End Function
Repeat For 20 ms
    PORTB.5 = 1
    PORTB.5 = 0
End Repeat
Do
Loop
