#chip mega328p, 16

'Repeat For test (Change 1654): Context: inside a Sub that is called twice, on mega328p
'Expect: compiles

#option explicit
Dim Flag As Bit
Dim Cnt As Byte
Dim Xv As Byte
Dim Yv As Byte
Dim W1 As Word
Dim W2 As Word
Sub Pace
    Repeat For 500 us
        Wait 10 us
    End Repeat
End Sub
Pace
Pace
Do
Loop
