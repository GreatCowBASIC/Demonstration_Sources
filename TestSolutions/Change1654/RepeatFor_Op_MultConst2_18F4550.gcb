#chip 18F4550, 20

'Repeat For test (Change 1654): Body operation: byte multiply by 2, on 18F4550
'Expect: compiles, and the whole Repeat For construct runs exactly 100,000 clock cycles
'(checked by simulating the generated assembly instruction by instruction)

#option explicit
Dim Flag As Bit
Dim Cnt As Byte
Dim X As Byte
Dim Y As Byte
Dim W1 As Word
Dim W2 As Word
Dim S1 As String
Dim Buf(8) As Byte
Table Tbl
    1, 2, 3
End Table
Sub Tick
    X = X + 1
End Sub
Function Plus1(Av As Byte) As Byte
    Plus1 = Av + 1
End Function
Repeat For 20 ms
    X = X * 2
End Repeat
Do
Loop
