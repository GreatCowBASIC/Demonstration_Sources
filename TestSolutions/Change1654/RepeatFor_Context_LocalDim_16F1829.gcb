#chip 16F1829, 8

'Repeat For test (Change 1654): Context: local variables used in the body, on 16F1829
'Expect: compiles

#option explicit
Dim Flag As Bit
Dim Cnt As Byte
Dim X As Byte
Dim Y As Byte
Dim W1 As Word
Dim W2 As Word
Sub Pace5
    Dim L1 As Byte
    Dim L2 As Word
    Repeat For 5 ms
        L1 = L1 + 1
        L2 = L2 + L1
    End Repeat
End Sub
Pace5
Do
Loop
