#chip mega328p, 16

'Repeat For test (Change 1654): Wait with a #define constant as the time (Wait PAUSE ms)
'Expect: compiles, and the whole Repeat For construct runs exactly 1,600,000 clock cycles
'(checked by simulating the generated assembly instruction by instruction)

#option explicit
#define PAUSE 5
Dim Xv As Byte

Repeat for 100 ms
    Wait PAUSE ms
    Xv = Xv + 1
End Repeat
Do
Loop
