#chip tiny13, 8

'Repeat For test (Change 1654): GATE FIX-shaped (large Wait, nop, If) loop on tiny13
'Expect: compiles - The cycle model for this reduced AVR core is not independently verified - this file only checks that it compiles.
'The cycle model for this reduced AVR core is not independently verified - this file only checks that it compiles.

#option explicit
Dim Flag As Bit
Dim Cnt As Byte
Dim Xv As Byte
Dim Yv As Byte
Dim W1 As Word
Dim W2 As Word
Repeat For 20 ms
    Wait 1009 us
    If Flag = 1 Then
        Xv = Xv + 1
        Flag = 0
    End If
End Repeat
Do
Loop
