#SKIPTEST
#chip mega328p, 16

'Repeat For test (Change 1654): Rejected: IntOff/IntOn in the body (interrupt enable instructions have no fixed cost)
'Expect: compile error (this file is marked #SKIPTEST so the demo sweep ignores it):
'  Repeat For cannot compute an exact cycle cost for an instruction inside its body [cli]

#option explicit
Dim Flag As Bit
Dim Cnt As Byte
Dim X As Byte
Dim Y As Byte
Dim W1 As Word
Dim W2 As Word
Dim Ticks As Byte
On Interrupt Timer0Overflow Call Tick
Sub Tick
    Ticks = Ticks + 1
End Sub
Repeat For 5 ms
    IntOff
    Wait 10 us
    IntOn
End Repeat
Do
Loop
