#chip mega4809, 16

'Repeat For test (Change 1654): The original GATE FIX example on mega4809. This chip has no TMR1IF bit; the equivalent is the TCA0 timer overflow flag TCA0_SINGLE_INTFLAGS.TCA_SINGLE_OVF_bp (cleared by writing 1).
'Expect: compiles, and the Repeat For construct runs exactly the requested 790,047 microseconds worth of clock cycles
'(checked by simulating the generated assembly instruction by instruction)

#option explicit
Dim Overflows As Byte
Repeat For 790047 us
    Wait 1009 us
    If TCA0_SINGLE_INTFLAGS.TCA_SINGLE_OVF_bp = 1 Then
        Overflows = Overflows + 1
        TCA0_SINGLE_INTFLAGS.TCA_SINGLE_OVF_bp = 1
    End If
End Repeat
Do
Loop
