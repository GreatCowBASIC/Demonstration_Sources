#chip mega328p, 16

'Repeat For test (Change 1654): Context: Repeat For inside an If, on mega328p
'Expect: compiles

#option explicit
Dim Flag As Bit
Dim Cnt As Byte
Dim X As Byte
Dim Y As Byte
Dim W1 As Word
Dim W2 As Word
If Flag = 0 Then
    Repeat For 500 us
        Wait 10 us
    End Repeat
End If
Do
Loop
