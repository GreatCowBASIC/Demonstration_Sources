#chip tiny202, 20

'Repeat For test (Change 1654): Loop body: byte arithmetic, on tiny202
'Expect: compiles, and the whole Repeat For construct runs exactly 400,000 clock cycles
'(checked by simulating the generated assembly instruction by instruction)

#option explicit
Dim Flag As Bit
Dim Cnt As Byte
Dim Xv As Byte
Dim Yv As Byte
Dim W1 As Word
Dim W2 As Word
Repeat For 20 ms
    Xv = Xv + Yv
    Yv = Yv + 3
End Repeat
Do
Loop
