#SKIPTEST
#chip mega328p, 16

'Repeat For test (Change 1654): Rejected: Exit Repeat with an Else branch
'Expect: compile error (this file is marked #SKIPTEST so the demo sweep ignores it):
'  Repeat For does not support If/Else inside its body - only If with no Else is supported Warning: Single letter variable name: X

#option explicit
Dim Flag As Bit
Dim Cnt As Byte
Dim Xv As Byte
Dim Yv As Byte
Dim W1 As Word
Dim W2 As Word
Dim S1 As String
Dim Buf(8) As Byte
Table Tbl
    1, 2, 3
End Table
Sub Tick
    Xv = Xv + 1
End Sub
Function Plus1(Av As Byte) As Byte
    Plus1 = Av + 1
End Function
Repeat For 20 ms
    If Flag = 1 Then
        Exit Repeat
    Else
        Xv = 1
    End If
End Repeat
Do
Loop
