#chip 16f877a, 20 
#option explicit
#DEFINE  USART_BAUD_RATE 9600
#define USART_TX_BLOCKING
#define USART_DELAY OFF

Dim Txt_Heading As String * 12 = "K9AY North"
Dim SignalLevel As Byte = 87
Dim SampleCount As Word = 4213

' ----- New way: one statement, mixed types -----
HSerPrintList "{STAT,", Txt_Heading, ",", SignalLevel, ",", SampleCount, "}","\r\n"
HserSendBytes (12,12,12)


Do
  Wait 1 s
Loop
