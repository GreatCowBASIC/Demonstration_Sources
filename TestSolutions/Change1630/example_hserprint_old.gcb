#chip 16F877A, 20
#define USART_BAUD_RATE 9600
#define USART_TX_BLOCKING
#define USART_DELAY OFF

Dim Txt_Heading As String * 12 = "K9AY North"
Dim SignalLevel As Byte = 87
Dim SampleCount As Word = 4213

' ----- Old way: one HSerPrint per value -----
HSerPrint "{STAT,"
HSerPrint Txt_Heading
HSerPrint ","
HSerPrint SignalLevel
HSerPrint ","
HSerPrint SampleCount
HSerPrint "}"
HSerPrint 13
HSerPrint 10

Do
  Wait 1 s
Loop
