// Build 1668: as stack_over_16f.gcb with #DEFINE DISABLE1668 - expected: compiles, the summary line, no warning
// Expected: Stack: 17 of 16 levels (main 17, interrupt none)

    #chip 16F18877, 32
    #option explicit

    #define DISABLE1668

    Dim StackCount As Byte
    StackCount = 0

    Level1

    Do Forever
    Loop

Sub Level1
    Level2
    StackCount = StackCount + 1
End Sub

