// Build 1668: an interrupt adds its entry and its own calls - expected: compiles, no warning (exactly full)
// 13 nested subs in the main program; the Timer0 handler calls 2 levels deep, and the interrupt code itself may
// call the handler. Expected: Stack: 16 of 16 levels (main 13, interrupt 1 + 2) - check the interrupt figure

    #chip 16F18877, 32
    #option explicit

    Dim StackCount As Byte
    StackCount = 0

    InitTimer0 Osc, PRE0_256 + TMR0_FOSC4, POST0_1
    StartTimer 0
    On Interrupt Timer0Overflow Call Handler1
    Level1

    Do Forever
    Loop

Sub Level1
    Level2
    StackCount = StackCount + 1
End Sub

Sub Level2
    Level3
    StackCount = StackCount + 1
End Sub

Sub Level3
    Level4
    StackCount = StackCount + 1
End Sub

Sub Level4
    Level5
    StackCount = StackCount + 1
End Sub

Sub Level5
    Level6
    StackCount = StackCount + 1
End Sub

Sub Level6
    Level7
    StackCount = StackCount + 1
End Sub

Sub Level7
    Level8
    StackCount = StackCount + 1
End Sub

Sub Level8
    Level9
    StackCount = StackCount + 1
End Sub

Sub Level9
    Level10
    StackCount = StackCount + 1
End Sub

Sub Level10
    Level11
    StackCount = StackCount + 1
End Sub

Sub Level11
    Level12
    StackCount = StackCount + 1
End Sub

Sub Level12
    Level13
    StackCount = StackCount + 1
End Sub

Sub Level13
    StackCount = StackCount + 1
End Sub

Sub Handler1
    Handler2
    StackCount = StackCount + 1
End Sub

Sub Handler2
    StackCount = StackCount + 1
End Sub

