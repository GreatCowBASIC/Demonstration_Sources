// Build 1668: AVR - the stack is in RAM: reported in bytes against the RAM the variables leave free
// 10 nested subs (2 bytes per call on the mega328p) and a Timer0 handler. Expected: Stack: <bytes> of <free> bytes
// of free RAM (main 20 or more: calls plus any pushes, interrupt 2 + the handler), no warning

    #chip mega328p, 16
    #option explicit

    Dim StackCount As Byte
    StackCount = 0

    InitTimer0 Osc, PS_0_256
    StartTimer 0
    On Interrupt Timer0Overflow Call Handler1
    Level1

    Do Forever
    Loop

Sub Level1
    Level2
    StackCount = StackCount + 1
End Sub

Sub Level2
    Level3
    StackCount = StackCount + 1
End Sub

Sub Level3
    Level4
    StackCount = StackCount + 1
End Sub

Sub Level4
    Level5
    StackCount = StackCount + 1
End Sub

Sub Level5
    Level6
    StackCount = StackCount + 1
End Sub

Sub Level6
    Level7
    StackCount = StackCount + 1
End Sub

Sub Level7
    Level8
    StackCount = StackCount + 1
End Sub

Sub Level8
    Level9
    StackCount = StackCount + 1
End Sub

Sub Level9
    Level10
    StackCount = StackCount + 1
End Sub

Sub Level10
    StackCount = StackCount + 1
End Sub

Sub Handler1
    Handler2
    StackCount = StackCount + 1
End Sub

Sub Handler2
    StackCount = StackCount + 1
End Sub

