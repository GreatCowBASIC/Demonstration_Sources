// Build 1668: the compiler reports the worst-case call stack - expected: compiles, no warning
// 10 nested subs, no interrupt. Expected summary line: Stack: 10 of 16 levels (main 10, interrupt none)

    #chip 16F18877, 32
    #option explicit

    Dim StackCount As Byte
    StackCount = 0

    Level1

    Do Forever
    Loop

Sub Level1
    Level2
    StackCount = StackCount + 1
End Sub

Sub Level2
    Level3
    StackCount = StackCount + 1
End Sub

Sub Level3
    Level4
    StackCount = StackCount + 1
End Sub

Sub Level4
    Level5
    StackCount = StackCount + 1
End Sub

Sub Level5
    Level6
    StackCount = StackCount + 1
End Sub

Sub Level6
    Level7
    StackCount = StackCount + 1
End Sub

Sub Level7
    Level8
    StackCount = StackCount + 1
End Sub

Sub Level8
    Level9
    StackCount = StackCount + 1
End Sub

Sub Level9
    Level10
    StackCount = StackCount + 1
End Sub

Sub Level10
    StackCount = StackCount + 1
End Sub

