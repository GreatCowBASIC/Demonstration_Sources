// Build 1668: over the stack - expected: compiles, with a Warning
// 17 nested subs on a 16-level stack. Expected: Stack: 17 of 16 levels (main 17, interrupt none) and
//   Warning: Worst-case call stack 17 exceeds the 16 available: LEVEL1 -> LEVEL2 -> ... -> LEVEL17 ...

    #chip 16F18877, 32
    #option explicit

    Dim StackCount As Byte
    StackCount = 0

    Level1

    Do Forever
    Loop

Sub Level1
    Level2
    StackCount = StackCount + 1
End Sub

Sub Level2
    Level3
    StackCount = StackCount + 1
End Sub

Sub Level3
    Level4
    StackCount = StackCount + 1
End Sub

