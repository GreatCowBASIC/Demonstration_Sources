    Level9
    StackCount = StackCount + 1
End Sub

Sub Level9
    Level10
    StackCount = StackCount + 1
End Sub

Sub Level10
    Level11
    StackCount = StackCount + 1
End Sub

Sub Level11
    Level12
    StackCount = StackCount + 1
End Sub

Sub Level12
    Level13
    StackCount = StackCount + 1
End Sub

Sub Level13
    Level14
    StackCount = StackCount + 1
End Sub

Sub Level14
    Level15
    StackCount = StackCount + 1
