'Change 1673 (AVR): a sub or function with a one or two character name, and the bracket straight after the
'name, keeps its parameters. Before 1673 AB(5) called AB without setting Value (no message).
'Expected output, one line each:
'6
'7
'Hello
'done

#chip mega328p, 16
#option Explicit

#define USART_BAUD_RATE 9600
#define USART_TX_BLOCKING

Dim Result As Byte

Result = AB(5)
HSerPrint Result
HSerSend 13
HSerSend 10

P2(3, 4)

HSerPrint SS("Hello")
HSerSend 13
HSerSend 10

HSerPrint "done"
HSerSend 13
HSerSend 10

Do
Loop

Function AB(In Value) As Byte
  AB = Value + 1
End Function

Sub P2(In First, In Second)
  HSerPrint First + Second
  HSerSend 13
  HSerSend 10
End Sub

Function SS(In InText As String) As String
  SS = InText
End Function
