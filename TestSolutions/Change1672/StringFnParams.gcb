'Change 1672: two string function results passed to one sub must both arrive.
'A string function returns its value in its own variable (Echo for Function Echo), and the sub is given a
'reference to that variable. Before 1672 the second call of Echo changed it again before CallSub ran, so
'CallSub("1.", Echo(" yyyy"), Echo(" xxxxx")) printed "1. xxxxx xxxxx".
'Expected output, one line each:
'1. yyyy xxxxx
'ABC
'ABC
'AB12!
'S1 S2
'done

#chip 18F27Q43, 64
#option Explicit

#define USART_BAUD_RATE 115200
#define USART_TX_BLOCKING

#startup PPSInit, 85

'The user's case: a constant, then two calls of the same string function
CallSub("1.", Echo(" yyyy"), Echo(" xxxxx"))

'Function results first and second, a constant last
CallSub(Echo("A"), Echo("B"), "C")

'Function result, constant, function result
CallSub(Echo("A"), "B", Echo("C"))

'A function with a fixed-length result (String * 4), then another function
CallSub(Short("AB"), Short("12"), "!")

'The same from inside a sub
InSub

HSerPrint "done"
HSerSend 13
HSerSend 10

Do
Loop

Sub PPSInit
  RC6PPS = 0x20           'RC6 is UART1 TX
End Sub

Sub InSub
  CallSub(Echo("S1"), Echo(" "), Echo("S2"))
End Sub

Sub CallSub(In FirstString As String, In SecondString As String, In ThirdString As String)
  HSerPrint FirstString
  HSerPrint SecondString
  HSerPrint ThirdString
  HSerSend 13
  HSerSend 10
End Sub

Function Echo(In InText As String) As String
  Echo = InText
End Function

Function Short(In ShortText As String) As String * 4
  Short = ShortText
End Function
