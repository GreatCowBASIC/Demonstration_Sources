              1289: ELSE
              ;SSD1306_VLine ( LineX1, LineY2, LineY1, LineColour )
              1290: SSD1306_VLINE ( LINEX1, LINEY2, LINEY1, LINECOLOUR )
              ;End If
              1291: END IF
              ;Exit Sub
              1292: EXIT SUB
              ;End If
              1293: END IF
              1365: #IFNDEF GLCD_TYPE_SSD1306_LOWMEMORY_GLCD_MODE
              ;SSD1306_HLine ( LineX1, LineX2, LineY1, LineColour )
              1366: SSD1306_HLINE ( LINEX1, LINEX2, LINEY1, LINECOLOUR )
              ;SSD1306_HLine ( LineX1, LineX2, LineY2, LineColour )
              1367: SSD1306_HLINE ( LINEX1, LINEX2, LINEY2, LINECOLOUR )
              ;SSD1306_VLine ( LineX1, LineY1, LineY2, LineColour )
              1368: SSD1306_VLINE ( LINEX1, LINEY1, LINEY2, LINECOLOUR )
              ;SSD1306_VLine ( LineX2, LineY1, LineY2, LineColour )
              1369: SSD1306_VLINE ( LINEX2, LINEY1, LINEY2, LINECOLOUR )
              1389: #IF GLCD_TYPE = GLCD_TYPE_SSD1306
              ;Select correct buffer element
              ;SSD1306_BufferLocationCalc = GLCDY
              1391: SSD1306_BUFFERLOCATIONCALC = GLCDY
              ;Divide by 8
              ;Repeat 3
              1393: REPEAT 3
              ;Set C Off
              1394: SET C OFF
              ;Rotate SSD1306_BufferLocationCalc Right
              1395: ROTATE SSD1306_BUFFERLOCATIONCALC RIGHT
              ;End Repeat
              1396: END REPEAT
              ;SSD1306_BufferLocationCalc = SSD1306_BufferLocationCalc * GLCD_WIDTH
              1397: SSD1306_BUFFERLOCATIONCALC = SSD1306_BUFFERLOCATIONCALC * GLCD_WIDTH
              ;SSD1306_BufferLocationCalc = GLCDX + SSD1306_BufferLocationCalc+1  'add 1 as we dont use element (0)
              1398: SSD1306_BUFFERLOCATIONCALC = GLCDX + SSD1306_BUFFERLOCATIONCALC+1
              ;GLCDDataTemp = SSD1306_BufferAlias(SSD1306_BufferLocationCalc)
              1399: GLCDDATATEMP = SSD1306_BUFFERALIAS(SSD1306_BUFFERLOCATIONCALC)
              ;Change data to examine pixel by rotating our bit to bit zero
              ;GLCDBitNo = GLCDY And 7
              1401: GLCDBITNO = GLCDY AND 7
              ;Repeat GLCDBitNo
              1402: REPEAT GLCDBITNO
              ;Rotate GLCDDataTemp right
              1403: ROTATE GLCDDATATEMP RIGHT
              ;End Repeat
              1404: END REPEAT
              ;PixelStatus_SSD1306 = GLCDDataTemp.0
              1405: PIXELSTATUS_SSD1306 = GLCDDATATEMP.0
              1617: #IFDEF HI2C_DATA
              ;HI2CStart
              1619: HI2CSTART
              ;HI2CSend GLCD_I2C_Address
              1620: HI2CSEND GLCD_I2C_ADDRESS
              ;HI2CSend 0x40
              1621: HI2CSEND 64
              1649: #IFDEF HI2C_DATA
              ;HI2CStart
              1651: HI2CSTART
              ;HI2CSend GLCD_I2C_Address
              1652: HI2CSEND GLCD_I2C_ADDRESS
              ;HI2CSend 0x00
              1653: HI2CSEND 0
              1686: #IFDEF HI2C_DATA
              ;HI2CSend SSD1306SendByte
              1688: HI2CSEND SSD1306SENDBYTE
              1719: #IFDEF HI2C_DATA
              ;HI2CSend SSD1306SendByte
              1721: HI2CSEND SSD1306SENDBYTE
              1744: #IFDEF HI2C_DATA
              ;HI2CStop
              1746: HI2CSTOP

