#chip 16F877A, 20

#define USART_BAUD_RATE 9600
#define USART_TX_BLOCKING
#define USART_DELAY OFF

'Regression check for Change1648: HSerPrintList with no leading [comport] argument
'at all (the original, pre-existing syntax) must still work unchanged - this is the
'exact example from the HSerPrintList Help page, predating the [comport] extension.

Dim Txt_Heading As String * 12 = "K9AY North"
Dim SignalLevel As Byte = 87
Dim SampleCount As Word = 4213

Do
  HSerPrintList "{STAT,", Txt_Heading, ",", SignalLevel, ",", SampleCount, "}", 13, 10
  Wait 1 s
Loop
