'''
'''HWI2C test - Change1641 - 18F26Q24 @ 125kHz
'''
'''Minimal hardware I2C bus-scan demo at HI2C_BAUD_RATE=125, one of three
'''frequency points (100/125/400 kHz) used to exercise hwi2c.h's automatic
'''I2C1CLOCKSOURCE/I2C1BAUD selection across its MFINTOSC/FOSC boundary -
'''see this folder's README.md.
'''
'''PPS/pin setup copied verbatim from the existing, already-verified
'''Vendor_Boards/Great_Cow_Basic_Demo_Board/18FxxQ24_Chiprange_Demonstrations/170_show_i2c_devices_to_serial_terminal.gcb
'''
'''@author  Automation
'''@date    2026-09-16
' ----- Configuration

'Chip Settings.
#CHIP 18F26Q24, 64
#OPTION Explicit

    #DEFINE USART_BAUD_RATE 9600
    #DEFINE USART_TX_BLOCKING

    'Generated by PIC PPS Tool for GCBASIC
    #startup InitPPS, 85
    #define PPSToolPart 18F26Q24

    Sub InitPPS

            'Module: UART1
            RC6PPS = 0x0015    'TX1 > RC6

            'Module: I2C1
            RC3PPS = 0x23    'RC3 > SCL1
            I2C1SCLPPS = 0x13    'SCL1 > RC3
            RC4PPS = 0x24    'RC4 > SDA1
            I2C1SDAPPS = 0x14    'SDA1 > RC4

    End Sub

' Define I2C settings
#DEFINE HI2C_BAUD_RATE 125
#DEFINE HI2C_DATA PORTC.4
#DEFINE HI2C_CLOCK PORTC.3

Dir HI2C_DATA Out
Dir HI2C_CLOCK Out

HI2CMode (Master)

#DEFINE MUTE_HIC2Q2XBUFFERSIZE_WARNING

'*****************************************************************************************************
'Main program commences here.. everything before this is setup for the board.

Dim DeviceID As Byte
Dim DISPLAYNEWLINE As Byte

Do

    HSerPrintCRLF
    HSerPrint "Hardware I2C - 18F26Q24 @ 125kHz"
    HSerPrintCRLF 2

    HSerPrintCRLF
    HSerPrint "   "
    For DeviceID = 0 To 15
        HSerPrint Hex(deviceID)
        HSerPrint " "
    Next

    For DeviceID = 0 To 255
        DisplayNewLine = DeviceID % 16
        If DisplayNewLine = 0 Then
            HSerPrintCRLF
            HSerPrint Hex(DeviceID)
        End If
        HSerPrint " "

        HI2CStart
        HI2CSend ( DeviceID )
        HI2CSend ( 0x00 )
        HI2CStop

        If HI2CAckpollState = FALSE Then
            HSerPrint Hex(DeviceID)
        Else
            HSerPrint "--"
        End If

    Next

    HSerPrintCRLF 2
    HSerPrint "End of Search"
    HSerPrintCRLF 2
    Wait 1 s

Loop

End
