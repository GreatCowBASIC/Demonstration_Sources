'''
'''HWI2C test - Change1641 - 18F16Q41 @ 100kHz
'''
'''Minimal hardware I2C bus-scan demo at HI2C_BAUD_RATE=100, one of three
'''frequency points (100/125/400 kHz) used to exercise hwi2c.h's automatic
'''I2C1CLOCKSOURCE/I2C1BAUD selection across its MFINTOSC/FOSC boundary -
'''see this folder's README.md.
'''
'''PPS/pin setup copied verbatim from the existing, already-verified
'''Vendor_Boards/Great_Cow_Basic_Demo_Board/18f16q41_chiprange_demonstrations/150_show_i2c_devices_to_serial_terminal.gcb
'''
'''@author  Automation
'''@date    2026-09-16
' ----- Configuration

'Chip Settings.
#CHIP 18F16Q41
#OPTION Explicit

    #DEFINE USART_BAUD_RATE 9600
    #DEFINE USART_TX_BLOCKING

    'Generated by PIC PPS Tool for GCBASIC
    #startup InitPPS, 85
    #define PPSToolPart 18f16q41

    Sub InitPPS

            'Module: I2C1
            RB6PPS = 0x0021    'SCL1 > RB6
            I2C1SCLPPS = 0x000E    'RB6 > SCL1 (bi-directional)
            RB4PPS = 0x0022    'SDA1 > RB4
            I2C1SDAPPS = 0x000C    'RB4 > SDA1 (bi-directional)

            'Module: UART pin directions
            Dir PORTC.6 Out    'Make TX1 pin an output
            'Module: UART1
            RC6PPS = 0x0010    'TX1 > RC6

    End Sub

' Define I2C settings
#DEFINE HI2C_BAUD_RATE 100
#DEFINE HI2C_DATA PORTB.4
#DEFINE HI2C_CLOCK PORTB.6

Dir HI2C_DATA Out
Dir HI2C_CLOCK Out

'*****************************************************************************************************
'Main program commences here.. everything before this is setup for the board.

Dim DeviceID As Byte
Dim DISPLAYNEWLINE As Byte

Do

    HSerPrintCRLF
    HSerPrint "Hardware I2C - 18F16Q41 @ 100kHz"
    HSerPrintCRLF 2

    HSerPrintCRLF
    HSerPrint "   "
    For DeviceID = 0 To 15
        HSerPrint Hex(deviceID)
        HSerPrint " "
    Next

    For DeviceID = 0 To 255
        DisplayNewLine = DeviceID % 16
        If DisplayNewLine = 0 Then
            HSerPrintCRLF
            HSerPrint Hex(DeviceID)
        End If
        HSerPrint " "

        SI2CDiscovery ( DeviceID )

        If HI2CWaitMSSPTimeout <> TRUE Then
            If HI2CAckpollState = FALSE Then
                HSerPrint Hex(deviceID)
            Else
                HSerPrint "--"
            End If
        Else
            HSerPrint "! "
        End If

    Next

    HSerPrintCRLF 2
    HSerPrint "End of Search"
    HSerPrintCRLF 2
    Wait 1 s

Loop

End
