#chip 18F46J50, 48

'Change1660 test: SHARED with an initial value - SHARED comes straight after the location,
'before "= value". Expect: compiles with no warnings; COUNTER at 0x400, set to 5.

Dim Buffer(15) As Byte At 0x400 SHARED
Dim Counter As Byte At 0x400 SHARED = 5

Buffer(1) = Counter

Do
Loop
