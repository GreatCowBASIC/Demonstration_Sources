              606: FOR CURRCHARROW = 1 TO 8
              ;CharColS=0
              607: CHARCOLS=0
              ;For Col=1 to GLCDfntDefaultsize
              608: FOR COL=1 TO GLCDFNTDEFAULTSIZE
              ;CharRowS=0
              609: CHARROWS=0
              ;For Row=1 to GLCDfntDefaultsize
              610: FOR ROW=1 TO GLCDFNTDEFAULTSIZE
              ;GLCDY = [word]CharLocY + CharRow + CharRowS
              611: GLCDY = [WORD]CHARLOCY + CHARROW + CHARROWS
              ;if CurrCharVal.0=1 then
              613: IF CURRCHARVAL.0=1 THEN
              ;PSet [word]CharLocX + CharCol + CharColS, GLCDY, LineColour
              614: PSET [WORD]CHARLOCX + CHARCOL + CHARCOLS, GLCDY, LINECOLOUR
              ;Else
              615: ELSE
              ;PSet [word]CharLocX + CharCol + CharColS, GLCDY, GLCDBackground
              616: PSET [WORD]CHARLOCX + CHARCOL + CHARCOLS, GLCDY, GLCDBACKGROUND
              ;End if
              617: END IF
              ;End if
              ;CharRowS +=1
              619: CHARROWS +=1
              ;Put out a white intercharacter pixel/space
              ;if ( CharCol + CharColS ) = ( GLCDFontWidth * GLCDfntDefaultsize) - GLCDfntDefaultsize - 1 then
              621: IF ( CHARCOL + CHARCOLS ) = ( GLCDFONTWIDTH * GLCDFNTDEFAULTSIZE) - GLCDFNTDEFAULTSIZE - 1 THEN
              ;PSet [word]CharLocX + CharCol + CharColS + 1, [word]CharLocY + CharRow+CharRowS -1, GLCDBackground
              622: PSET [WORD]CHARLOCX + CHARCOL + CHARCOLS + 1, [WORD]CHARLOCY + CHARROW+CHARROWS -1, GLCDBACKGROUND
              ;end if
              623: END IF
              ;Next Row
              624: NEXT ROW
              ;CharColS +=1
              625: CHARCOLS +=1
              ;Next Col
              626: NEXT COL
              ;Rotate CurrCharVal Right
              627: ROTATE CURRCHARVAL RIGHT
              ;CharRow +=GLCDfntDefaultsize
              628: CHARROW +=GLCDFNTDEFAULTSIZE
              ;Next
              629: NEXT
              ;CharCol +=GLCDfntDefaultsize
              630: CHARCOL +=GLCDFNTDEFAULTSIZE
              635: #IFDEF GLCD_TYPE_SSD1306_CHARACTER_MODE_ONLY
              ;Ensure this is not called with in Low memory mode
              638: #IFNDEF GLCD_TYPE_SSD1306_LOWMEMORY_GLCD_MODE
              ;GLCDX = ( CharLocX + CurrCharCol -1 )
              640: GLCDX = ( CHARLOCX + CURRCHARCOL -1 )
              642: #IFDEF GLCD_PROTECTOVERRUN
              ;anything off screen with be rejected
              ;if GLCDX => GLCD_WIDTH OR CharLocY => GLCD_HEIGHT Then
              645: IF GLCDX } GLCD_WIDTH OR CHARLOCY } GLCD_HEIGHT THEN
              ;exit for
              646: EXIT FOR
              ;end if
              647: END IF
              874: #IFDEF GLCD_TYPE_SSD1306_CHARACTER_MODE_ONLY
              ;Close_Transaction_SSD1306
              875: CLOSE_TRANSACTION_SSD1306
              905: #IF GLCD_TYPE = GLCD_TYPE_SSD1306 OR GLCD_TYPE = GLCD_TYPE_SSD1306_32 OR GLCD_TYPE = GLCD_TYPE_SSD1306_64X32
              ;Draw lines going across
              ;For DrawLine = LineX1 To LineX2
              907: FOR DRAWLINE = LINEX1 TO LINEX2
              ;For GLCDTemp = LineY1 To LineY2
              908: FOR GLCDTEMP = LINEY1 TO LINEY2
              ;PSet DrawLine, GLCDTemp, LineColour
              909: PSET DRAWLINE, GLCDTEMP, LINECOLOUR
              ;Next
              910: NEXT
              ;Next
              911: NEXT
              936: #IF GLCD_TYPE = GLCD_TYPE_SSD1306 OR GLCD_TYPE = GLCD_TYPE_SSD1306_32 OR GLCD_TYPE = GLCD_TYPE_SSD1306_64X32
              938: #IFDEF GLCD_PROTECTOVERRUN
              ;anything off screen with be rejected
              ;if GLCDX => GLCD_WIDTH OR GLCDY => GLCD_HEIGHT Then
              940: IF GLCDX } GLCD_WIDTH OR GLCDY } GLCD_HEIGHT THEN
              ;exit sub
              941: EXIT SUB
              ;end if
              942: END IF
              947: #IFDEF GLCD_TYPE_SSD1306_LOWMEMORY_GLCD_MODE
              ;Is YPOS addressing the page we need?
              ;SSD1306_BufferLocationCalc = GLCDY
              ;Repeat 3
              ;Set C Off
              ;Rotate SSD1306_BufferLocationCalc Right
              ;End Repeat
              ;if SSD1306_BufferLocationCalc = _GLCDPage then
              ;GLCDY_Temp = ( GLCDY / 8 )* GLCD_WIDTH
              ;faster than /8
              ;GLCDY_Temp = GLCDY
              959: GLCDY_TEMP = GLCDY
              ;Repeat 3
              960: REPEAT 3
              ;Set C Off
              961: SET C OFF
              ;Rotate GLCDY_Temp Right
              962: ROTATE GLCDY_TEMP RIGHT
              ;End Repeat
              963: END REPEAT
              ;if GLCDY_Temp = _GLCDPage then
              965: IF GLCDY_TEMP = _GLCDPAGE THEN
              ;Mod the YPOS to get the correct pixel with the page
              ;GLCDY = GLCDY mod 8
              967: GLCDY = GLCDY MOD 8
              ;Else
              968: ELSE
              ;Exit if not the page we are looking for
              ;exit sub
              970: EXIT SUB
              ;end if
              971: END IF
              ;buffer location in LOWMEMORY_GLCD_MODE always equals GLCDX + 1
              ;SSD1306_BufferLocationCalc = GLCDX + 1
              973: SSD1306_BUFFERLOCATIONCALC = GLCDX + 1
              1033: #IFDEF GLCD_TYPE_SSD1306_LOWMEMORY_GLCD_MODE
              ;restore address the correct page by adjustng the Y
              ;GLCDY = GLCDY + ( 8 * _GLCDPage )
              1035: GLCDY = GLCDY + ( 8 * _GLCDPAGE )
              ;if SSD1306_BufferAlias(SSD1306_BufferLocationCalc) <> GLCDDataTemp then
              1036: IF SSD1306_BUFFERALIAS(SSD1306_BUFFERLOCATIONCALC) ~ GLCDDATATEMP THEN
              ;SSD1306_BufferAlias(SSD1306_BufferLocationCalc) = GLCDDataTemp
              1037: SSD1306_BUFFERALIAS(SSD1306_BUFFERLOCATIONCALC) = GLCDDATATEMP
              ;end if
              1038: END IF
              1097: #IFDEF GLCD_TYPE_SSD1306_64X32_XOFFSET
              ;LocX = LocX + GLCD_TYPE_SSD1306_64x32_XOFFSET
              1104: LOCX = LOCX + GLCD_TYPE_SSD1306_64X32_XOFFSET
              1235: #IFDEF GLCD_TYPE_SSD1306_LOWMEMORY_GLCD_MODE
              ;dim _GLCDPage as byte
              1237: DIM _GLCDPAGE AS BYTE
              ;Clear buffer
              ;for _GLCDPage = _GLCDPagesL to _GLCDPagesH    '_GLCDPage is a global variable - DO NOT CHANGE!!!
              1239: FOR _GLCDPAGE = _GLCDPAGESL TO _GLCDPAGESH
              1248: #IFDEF GLCD_TYPE_SSD1306_LOWMEMORY_GLCD_MODE
              ;Set cursor position
              ;Cursor_Position_SSD1306 ( 0, 8 * _GLCDPage )
              1251: CURSOR_POSITION_SSD1306 ( 0, 8 * _GLCDPAGE )
              ;Send the buffer to the device using transaction
              ;Open_Transaction_SSD1306
              1254: OPEN_TRANSACTION_SSD1306
              ;for SSD1306_BufferLocationCalc = 1 to 128
              1256: FOR SSD1306_BUFFERLOCATIONCALC = 1 TO 128
              ;Write_Transaction_Data_SSD1306 SSD1306_BufferAlias(SSD1306_BufferLocationCalc)
              1257: WRITE_TRANSACTION_DATA_SSD1306 SSD1306_BUFFERALIAS(SSD1306_BUFFERLOCATIONCALC)
              ;Clear the buffer byte. We need it to be empty for the next page operation
              ;SSD1306_BufferAlias(SSD1306_BufferLocationCalc) = 0
              1259: SSD1306_BUFFERALIAS(SSD1306_BUFFERLOCATIONCALC) = 0
              ;next
              1260: NEXT
              ;Close_Transaction_SSD1306
              1262: CLOSE_TRANSACTION_SSD1306
              ;next
              1264: NEXT
              1276: #IFDEF I2C_DATA
              ;I2CStart
              1278: I2CSTART
              ;I2CSend GLCD_I2C_Address
              1279: I2CSEND GLCD_I2C_ADDRESS
              ;I2CSend 0x40
              1280: I2CSEND 64
              1315: #IFDEF I2C_DATA
              ;I2CSend SSD1306SendByte
              1317: I2CSEND SSD1306SENDBYTE
              1340: #IFDEF I2C_DATA
              ;I2CStop
              1342: I2CSTOP

