              ;Set SSPCON1.SSPEN Off
              263: SET SSPCON1.SSPEN OFF
              ;Set clock pulse settings
              ;Set SSPSTAT.SMP Off
              266: SET SSPSTAT.SMP OFF
              ;Data write on rising (idle > active) clock (CPHA = 1)
              ;Set SSPSTAT.CKE Off
              268: SET SSPSTAT.CKE OFF
              ;Clock idle low (CPOL = 0)
              ;Set SSPCON1.CKP Off
              270: SET SSPCON1.CKP OFF
