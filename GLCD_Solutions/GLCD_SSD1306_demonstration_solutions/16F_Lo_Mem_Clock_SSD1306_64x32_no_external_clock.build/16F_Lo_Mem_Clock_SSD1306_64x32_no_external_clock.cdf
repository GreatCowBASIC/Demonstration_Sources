              ;Clear WCOL
              ;Set SSPCON1.WCOL Off
              870: SET SSPCON1.WCOL OFF
              ;Put byte to send into buffer
              ;Will start transfer
              ;SSPBUF = SPITxData
              874: SSPBUF = SPITXDATA
              ;Slave mode
              ;Else
              877: ELSE
